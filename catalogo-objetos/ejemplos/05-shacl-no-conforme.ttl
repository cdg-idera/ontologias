@prefix ex: <https://cdg-idera.github.io/ontologias/catalogo-objetos/ejemplos/> .
@prefix idera: <https://cdg-idera.github.io/ontologias/catalogo-objetos/> .
@prefix idera-feature: <https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/> .
@prefix idera-attr: <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/> .

# ============================================================
# Ejemplo 5
# Instancia deliberadamente NO conforme con SHACL
# ============================================================

ex:parcela-005
    a idera-feature:110101 ;
    ex:superficieDeclaradaIncorrecta "mil doscientos cincuenta" .

# La propiedad local corresponde semánticamente al mismo
# atributo IDERA ARA utilizado en el ejemplo conforme.

ex:superficieDeclaradaIncorrecta
    idera:correspondeAtributo idera-attr:ARA .