@prefix ex: <https://cdg-idera.github.io/ontologias/catalogo-objetos/ejemplos/> .
@prefix idera-feature: <https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

# ============================================================
# Ejemplo 7
# Geometría deliberadamente incompatible con Parcela
# ============================================================

ex:parcela-007
    a idera-feature:110101 ;
    geo:hasGeometry ex:geom-parcela-007 .

ex:geom-parcela-007
    a geo:Geometry ;
    geo:asWKT
        "POINT (-68.10 -38.95)"^^geo:wktLiteral .