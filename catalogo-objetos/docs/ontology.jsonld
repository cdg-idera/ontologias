  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende desde el paso Cochamo sobre el límite internacional por camino hacia la localidad de Río Villegas, línea recta a Las Bayas, Ruta Nacional Nº 40 hasta el límite interprovincial con Chubut y por este último hasta el límite internacional."
  } ]
