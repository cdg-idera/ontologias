  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Glaciología"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Objetos geográficos que se relacionan con reservas hídricas estratégicas en estado sólido, nieve, hielo y otras geoformas de origen glaciario (IDERA, 2015)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
