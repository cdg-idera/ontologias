  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/10",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Elaboración de productos alimenticios"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "10"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la elaboración de los productos de la agricultura, la ganadería, la silvicultura y la pesca para convertirlos en alimentos y bebidas para consumo humano o animal, e incluye la producción de varios productos intermedios que no son directamente productos alimenticios. Se organiza por actividades que se realizan con los distintos tipos de productos: carne, pescado, fruta, legumbres y hortalizas, grasas y aceites, productos lácteos, productos de molinería, alimentos preparados para animales y otros productos alimenticios y bebidas."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/100",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de ladrillos"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "100"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de ladrillos y productos conexos, incluyendo las ladrilleras."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/11",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Elaboración de bebidas"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "11"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la elaboración de bebidas no alcohólicas y agua mineral, la elaboración de bebidas alcohólicas obtenidas principalmente por fermentación, como cerveza y vino, y la elaboración de bebidas alcohólicas destiladas. No se incluyen la producción de jugos de frutas y de hortalizas, la elaboración de bebidas a base de leche, ni la elaboración de productos de café, té y mate."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/12",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Elaboración de productos de tabaco"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "12"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la elaboración de un producto agrícola, el tabaco, en forma adecuada para su consumo final."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/13",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de productos textiles"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "13"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la preparación e hilatura de fibras textiles y la tejedura y el acabado de productos textiles y prendas de vestir, así como la fabricación de artículos confeccionados de materiales textiles, excepto prendas de vestir."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/14",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de prendas de vestir"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "14"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende todas las actividades de confección, en todo tipo de materiales (cuero, tela, tejidos de punto y ganchillo, etc.), de todo tipo de prendas de vestir y accesorios."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/15",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de productos de cuero y productos conexos"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "15"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende el adobo y teñido de pieles, la transformación de pieles en cuero mediante operaciones de curtido y adobo y la fabricación de productos acabados de cuero. Abarca también la fabricación de productos similares a partir de otros materiales (cueros de imitación o sucedáneos de cuero), como calzado de caucho, maletas de materiales textiles, y otros."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/16",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Producción de madera y fabricación de productos de madera y corcho, excepto muebles"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "16"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de productos de madera, como maderos, tableros contrachapados, hojas de madera para enchapado, contenedores de madera, pisos de madera, armazones de madera y edificios prefabricados de madera. Los procesos de producción comprenden el aserrado, la acepilladura, el recorte, el laminado y el ensamblaje de productos de madera a partir de troncos que se cortan en trozos o maderos que se pueden volver a cortar o a los que se puede dar forma con tornos u otras herramientas."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/17",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de papel y de productos de papel"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "17"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de pasta de madera, papel y productos de papel. La fabricación de esos productos está agrupada porque abarca una serie de procesos conectados verticalmente. Es frecuente que una misma unidad realice más de una de esas actividades. Se trata esencialmente de tres actividades: la fabricación de pasta de madera entraña la separación de las fibras de celulosa de otras impurezas de la madera o el papel usado; la fabricación de papel consiste en el afeltrado de esas fibras hasta convertirlas en una lámina."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/18",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Impresión y reproducción de grabaciones"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "18"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la impresión de productos, como periódicos, libros, revistas, formularios comerciales, tarjetas de felicitación y otros materiales, y actividades de apoyo conexas, como encuadernación, servicios de preparación de placas y formación de imágenes a partir de datos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/19",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de coque y productos de la refinación del petróleo"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "19"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la transformación del petróleo crudo y el carbón en productos utilizables. El proceso principal es la refinación del petróleo, que entraña la separación del petróleo crudo en los distintos productos. Comprende la fabricación de gases, como etano, propano y butano, como productos de las refinerías de petróleo."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/20",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de sustancias y productos químicos"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "20"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la transformación de materias primas orgánicas e inorgánicas mediante un proceso químico y la formación de productos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/21",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de productos farmacéuticos, sustancias químicas medicinales y productos botánicos."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "21"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de productos farmacéuticos básicos y preparados farmacéuticos. Se incluye también la fabricación de sustancias químicas medicinales y productos botánicos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/22",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de productos de caucho y de plástico"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "22"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de productos de caucho y de plástico. La división se define por las materias primas utilizadas en el proceso de fabricación, lo que no significa que se clasifique en ella la fabricación de todos los productos hechos con esos materiales."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/23",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de otros productos minerales no metálicos"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "23"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de vidrio y productos de vidrio, productos de cerámica, losetas y productos de arcilla cocida, y cemento y yeso desde las materias primas hasta los artículos acabados. Se incluyen también el corte, la talla y el acabado de la piedra, secaderos de sal, y otros productos minerales."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/24",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de metales comunes"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "24"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende las actividades de fundición y/o refinación de metales ferrosos y no ferrosos a partir de mineral y escorias de hierro, por medio de técnicas electrometalúrgicas y de otras técnicas metalúrgicas. Abarca también la fabricación de aleaciones y superaleaciones de metales mediante la introducción de otros elementos químicos en los metales puros."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/25",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de productos elaborados de metal, excepto maquinaria y equipo"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "25"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de productos de metal “puro” (como partes, recipientes y estructuras) que normalmente tienen una función estática, inamovible. También se incluye la fabricación de armas y municiones."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/26",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de productos de informática, de electrónica y de óptica"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "26"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de ordenadores, equipo periférico, equipo de comunicaciones y productos electrónicos similares, así como la fabricación de componentes para esos productos. También se incluye la fabricación de aparatos electrónicos de consumo, equipo de medición, prueba, navegación y control, equipo de irradiación, equipo electrónico de uso médico y terapéutico, instrumentos y equipo ópticos y soportes magnéticos y ópticos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/27",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de equipo eléctrico"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "27"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de productos que se utilizan para generar, distribuir y utilizar energía eléctrica. También se incluye la fabricación de lámparas eléctricas, equipo de señales y aparatos eléctricos de uso doméstico. No se incluye la fabricación de productos electrónicos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/28",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de maquinaria y equipo n.c.p."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "28"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de maquinaria y equipo que actúan de manera independiente sobre los materiales ya sea mecánica o térmicamente, o que realizan operaciones sobre los materiales (como el manejo, el rociado, el pesado o el embalado), incluidos sus componentes mecánicos que producen y aplican fuerza, y cualquier parte primaria fabricada especialmente. Se incluye la fabricación de aparatos fijos y móviles o manuales, destinados a ser utilizados en actividades industriales, de construcción y de ingeniería civil, en la agricultura o en el hogar. Se incluye también la fabricación de equipo especial para el trasporte de pasajeros o de carga en zonas delimitadas. Se incluye también la fabricación de otros tipos de maquinaria de uso especial no clasificados en otra parte, se utilicen o no en un proceso de manufactura, como equipo para atracciones de feria, equipo automático para boleras, y otros."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/29",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de vehículos automotores, remolques y semirremolques"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "29"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de vehículos automotores para el transporte de pasajeros o de carga. Se incluye la fabricación de diversas partes, piezas y accesorios, así como la fabricación de remolques y semirremolques."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/30",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de otro equipo de transporte"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "30"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de equipo de transporte, como la construcción de buques y otras embarcaciones, la fabricación de locomotoras y material rodante, aeronaves y naves espaciales y la fabricación de partes y piezas de los mismos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/31",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fabricación de muebles"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "31"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de muebles y productos conexos de cualquier material, excepto piedra, hormigón y cerámica. Los procesos utilizados en la fabricación de muebles son métodos estandarizados para conformar materiales y ensamblar componentes, como el corte, el moldeo y la laminación."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/32",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Otras industrias manufactureras"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "32"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende la fabricación de diversos productos no clasificados en otra parte. Puesto que se trata de una división residual, los procesos de producción, los materiales utilizados como insumos y la utilización de los productos resultantes pueden variar considerablemente, y no se han aplicado los criterios habitualmente empleados para agrupar las clases en divisiones."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/33",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Reparación e instalación de maquinaria y equipo"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "33"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Comprende las actividades de reparación de productos para volver a poner en funcionamiento maquinaria, equipo y otros productos. Se incluyen las actividades de mantenimiento (servicio) general u ordinario de esos productos para garantizar que funcionen eficientemente y prevenir averías y reparaciones innecesarias."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/-1",
