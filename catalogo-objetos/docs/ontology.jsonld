  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Cuando el radio está conformado por viviendas diseminadas en campo abierto, con población rural dispersa, y con población agrupada en pequeños poblados o en bordes de amanzanados de localidades."
  } ]
