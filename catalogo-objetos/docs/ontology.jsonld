  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Cuando el radio está conformado por viviendas diseminadas en campo abierto, con población dispersa únicamente."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TRO/3",
