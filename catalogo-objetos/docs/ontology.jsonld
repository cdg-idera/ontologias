    "@language" : "es",
    "@value" : "Geología"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Objetos geográficos que hacen referencia a diferentes tipos de roca, según sus propiedades y edad; sus relaciones de contacto y estructuras geológicas (IDERA, 2015)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "0510"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esSubclaseDe" : [ {
