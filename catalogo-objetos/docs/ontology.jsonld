    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Desembocadura ancha de una corriente de agua, donde accionan las mareas y se mezclan las aguas en marea alta."
  } ]
}, {
