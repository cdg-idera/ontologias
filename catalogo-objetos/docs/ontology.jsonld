  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Superficie de tierra de relieve accidentado que sobresale de la línea de costa y penetra en el mar."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/13",
