}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Industria Y Servicios"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Comprende los objetos geográficos relacionados con la extracción y procesamiento de recursos naturales, producción agropecuaria, minería, industrialización, energía, comunicaciones, almacenamiento y logística, tratamiento y gestión de los residuos (IDERA, 2015)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "01"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esClaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Infraestructura Social"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Comprende los objetos geográficos que se relacionan en el sentido más amplio con los aspectos sociales de la población. A esta clase pertenecen los dominios de la administración, el comercio, el turismo, el ocio, la educación, la cultura, la salud y la ciencia (IDERA, 2018 - INFUETUR 2024)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "02"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esClaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Transporte"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Comprende los objetos geográficos que se relacionan con el conjunto de instalaciones fijas, entidades de flujo y un sistema de control que permiten que personas y  bienes venzan la fricción del espacio geográfico 'eficientemente' a efectos de participar oportunamente en alguna actividad deseada (IDERA, 2015)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "03"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esClaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Hidrografía Y Oceanografía"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Comprende los objetos geográficos naturales y artificiales relacionados a los ambientes marino, fluvial y lacustre. Incluye las características físicas y químicas del agua, la biología marina y la geología marina (IDERA, 2015)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "04"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esClaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"
  } ]
}, {
