  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Porción de mar relativamente larga y estrecha que conecta dos cuerpos de agua (mares, océanos o lagos), y por tanto, se encuentra entre dos masas de tierra. Ejemplo: Estrecho de Magallanes."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/14",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
