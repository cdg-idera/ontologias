  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "También llamada soft breakline. Es aquella que permite añadir mayor definición al modelo en zonas donde, aunque no cambia de forma abrupta la orientación de la pendiente, se recoge la forma de algún elemento determinado."
  } ]
