  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Cuerpo de agua salada de menor extensión que los océanos, cercado de continentes y generalmente conectado con un océano o con un mar mayor."
