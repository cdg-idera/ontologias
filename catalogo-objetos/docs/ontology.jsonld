  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Macizo de tierra que se eleva artificialmente para hacer una defensa, vía de comunicación u otra obra semejante."
  } ]
