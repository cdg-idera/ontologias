  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Depresión del terreno natural o como resultado de efectuar un corte en el mismo para el asentamiento de una vía de comunicación, quedando esta situada entre dos paredes (taludes) para permitir la circulación a una altura inferior al perfil orográfico."
  } ]
}, {
