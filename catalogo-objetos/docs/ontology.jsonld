  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Extensión con escaso relieve y elevada altitud, que se encuentra generalmente localizada entre dos o más cadenas montañosas, pero cuyo levantamiento no ocurrió al mismo tiempo. También suele denominarse altiplanicie."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/8",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
