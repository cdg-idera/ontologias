    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Cuando no se dispone o no se tiene certeza de los datos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "I"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "1"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Muy débil. Imperceptible para la mayoría excepto en condiciones favorables. Aceleración menor a 0,5 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/10",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "X"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "10"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Desastroso. Algunas estructuras de madera bien construidas quedan destruidas. La mayoría de las estructuras de mampostería y el marco destruido con sus bases. Vías ferroviarias dobladas. Aceleración entre 250 y 500 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/11",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "XI"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "11"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Muy desastroso. Pocas estructuras de mampostería, si las hubiera, permanecen en pie. Puentes destruidos. Vías ferroviarias curvadas en gran medida. Aceleración mayor a 500 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/12",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "XII"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "12"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Catastrófico. Destrucción total con pocos supervivientes. Los objetos saltan al aire. Los niveles y perspectivas quedan distorsionados. Imposibilidad de mantenerse en pie."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "II"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "2"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Débil. Perceptible sólo por algunas personas en reposo, particularmente aquellas que se encuentran ubicadas en los pisos superiores de los edificios. Los objetos colgantes suelen oscilar. Aceleración entre 0,5 y 2,5 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "III"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "3"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Leve. Perceptible por algunas personas dentro de los edificios, especialmente en pisos altos. Muchos no lo perciben como un terremoto. Los automóviles detenidos se mueven ligeramente. Sensación semejante al paso de un camión pequeño. Aceleración entre 2,5 y 6,0 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/4",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "IV"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "4"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Moderado. Perceptible por la mayoría de personas dentro de los edificios, por pocas personas en el exterior durante el día. Durante la noche algunas personas pueden despertarse. Perturbación en cerámica, puertas y ventanas. Las paredes suelen hacer ruido. Los automóviles detenidos se mueven con más energía. Sensación semejante al paso de un camión grande. Aceleración entre 6,0 y 10 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/5",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "V"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "5"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Poco fuerte. Sacudida sentida casi por todo el país o zona y algunas piezas de vajilla o cristales de ventanas se rompen; pocos casos de agrietamiento de aplanados; caen objetos inestables. Se observan perturbaciones en los árboles, postes y otros objetos altos. Se detienen los relojes de péndulo. Aceleración entre 10 y 20 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/6",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "VI"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "6"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Fuerte. Sacudida sentida por todo el país o zona. Algunos muebles pesados cambian de sitio y provoca daños leves, en especial en viviendas de material ligero. Aceleración entre 20 y 35 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/7",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "VII"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "7"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Muy fuerte. Ponerse de pie es difícil. Muebles dañados. Daños insignificantes en estructuras de buen diseño y construcción. Daños leves a moderados en estructuras ordinarias bien construidas. Daños considerables en estructuras pobremente construidas. Mampostería dañada. Perceptible por personas en vehículos en movimiento. Aceleración entre 35 y 60 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/8",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "VIII"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "8"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Destructivo. Daños leves en estructuras especializadas. Daños considerables en estructuras ordinarias bien construidas, posibles derrumbes. Daño severo en estructuras pobremente construidas. Mampostería seriamente dañada o destruida. Muebles completamente sacados de lugar. Aceleración entre 60 y 100 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/9",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "IX"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "9"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Muy destructivo. Pánico generalizado. Daños considerables en estructuras especializadas, paredes fuera de plomo. Grandes daños en importantes edificios, con derrumbes parciales. Edificios desplazados fuera de las bases. Aceleración entre 100 y 250 Gal."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/-1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Información no disponible"
  } ],
