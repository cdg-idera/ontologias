  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Categoría I (rojo:) zona de alto valor de conservación"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "1"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Valor de dominio que denota un  muy alto de conservación. Incluye áreas que por sus ubicaciones relativas a reservas, su valor de conectividad, la presencia de valores biológicos sobresalientes y/o la protección de cuencas que ejercen, ameritan su persistencia como bosque a perpetuidad, aunque estos sectores puedan ser hábitat de comunidades indígenas y ser objeto de investigación científica."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAM/2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Categoría II (amarillo): zona de valor medio de conservación"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "2"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAM"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Valor de dominio que denota un mediano valor de conservación, que pueden estar degradados pero que a juicio de la autoridad de aplicación jurisdiccional con la implementación de actividades de restauración pueden tener un valor alto de conservación y que podrán ser sometidos a los siguientes usos: aprovechamiento sostenible, turismo, recolección e investigación científica."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAM/3",
