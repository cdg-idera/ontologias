  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1102",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Minero"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Objetos territoriales legales relacionados al registro público de los Derechos Mineros existentes. Éste mantiene el registro y documentos inherentes de la identificación, ubicación, extensión, tipo y propiedad de las áreas afectadas de solicitudes y derechos mineros. Se encuentra organizado para cumplir funciones fiscales, jurídicas y administrativas (AGC Catamarca, 2016)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "1102"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esSubclaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11"
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1201",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Divisiones Censales"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Comprende el conjunto de divisiones del territorio diseñadas por el INDEC que permiten aseguran la cobertura total del país al momento de llevar adelante los distintos operativos censales (INDEC, 2018)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "1201"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esSubclaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12"
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Áreas Urbanas Censales"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Comprende aquellas porciones del territorio donde se asienta la población y que presenta características distintivas y particulares que permiten diferenciarlas de aquellas zonas no urbanas (INDEC, 2018)."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "1202"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esSubclaseDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12"
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/2301",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Entidad De Información"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Entidades que se utilizan para modelar la información relativa a los tipos de fenómenos, pero que no representan fenómenos en sí mismos. Por ejemplo, las características del pavimento compartidas por muchos tipos de rutas de transporte terrestre, o las características de calidad de los datos compartidas por todas las masas de agua continentales. (Adaptación del DFDD) - IDESoB 2024"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "2301"
  } ],
