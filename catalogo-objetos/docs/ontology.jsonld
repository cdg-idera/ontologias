  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Valle de origen fluvial inundado por el mar. Ejemplo: Ría del Río Deseado."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/7",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
