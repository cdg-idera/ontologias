}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/NEN/1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Inicial"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "1"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NEN"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Nivel que tiene por objeto brindar una formación integral que abarca los aspectos sociales, afectivo-emocionales, cognitivos, motrices y expresivos de manera que se promueva y profundice la calidad de los aprendizajes en etapas posteriores. Constituye una unidad pedagógica destinada a niños desde los 45 días a 5 años siendo obligatorios los últimos dos años (sala de 4 y sala de 5)."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/NEN/2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Primario"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "2"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NEN"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Nivel que tiene por objeto la adquisición de competencias básicas, la apropiación de conocimientos habilidades y valores comunes imprescindibles para toda la población. Para la modalidad común y especial constituye una unidad pedagógica obligatoria a partir de los 6 años de edad cumplidos  al día 30 de junio y tiene una duración de 6 o 7 años según la estructura que haya optado cada jurisdicción. Para la modalidad Jóvenes y Adultos existen ofertas específicas que se organizan con una menor duración en los estudios. En ambos casos habilita a cursar el nivel secundario."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/NEN/3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Secundario"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "3"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NEN"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Nivel que tiene por objeto profundizar los saberes, habilidades y valores en función de las áreas de conocimiento del mundo social y del trabajo, habilita para cursar el nivel superior. Constituye una unidad pedagógica obligatoria destinada a adolescentes, jóvenes y adultos que hayan aprobado el nivel primario. Consta de dos ciclos: a)Ciclo Básico: con contenidos curriculares comunes y b) Ciclo Orientado: de caracter especializado según las distintas áreas del conocimiento y el mundo del trabajo."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/NEN/4",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Superior - Institutos no universitarios"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "4"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NEN"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Están destinados a la formación y capacitación para el ejercicio de la docencia y a la formación superior de carácter instrumental en las áreas humanísticas, sociales, artísticas de formación Técnico Profesional regidas por la ley 26.058"
  } ]
