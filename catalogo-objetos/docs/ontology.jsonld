  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Humedal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Áreas del territorio que se caracterizan por la presencia temporaria o permanente de agua, suelos o sustratos característicos y biota adaptada a estas condiciones, comúnmente plantas hidrófitas. Incluye las extensiones de marismas, pantanos y turberas, o superficies cubiertas de aguas, sean éstas de régimen natural o artificial, permanentes o temporales, estancadas o corrientes, dulces, salobres o saladas, incluidas las extensiones de agua marina cuya profundidad en marea baja no exceda de seis metros."
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
    "@value" : "041111"
  } ],
