  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Zona de Frontera para el Desarrollo y Zona de Seguridad de Fronteras"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "1"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TZZ"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Zona de seguridad destinada a complementar las previsiones territoriales de la defensa nacional. Comprende una faja a lo largo de la frontera terrestre y marítima a partir del límite internacional."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TZZ/2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Zona de Seguridad de Fronteras"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "2"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TZZ"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Zona que se encuentra en las provincias de Santa Cruz, Chubut y Río Negro. Se extiende desde Cabo Vírgenes, Ruta Provincial Nº 1 hasta Río Gallegos, desde esta ciudad por Ruta Nacional Nº 3 hacia el Norte hasta El Salado. Desde este punto por Rutas Provinciales Nº 47 y Nº 66 hasta Antonio de Biedma, desde allí por vías del Ferrocarril hasta Las Heras. Desde este punto por Ruta Provincial Nº 16 hasta Holdich y vías del Ferrocarril General Roca hasta Pampa del Castillo en la provincia de Chubut. Desde esta localidad por Ruta Provincial Nº 37 hasta su intersección con la Ruta Nacional Nº 3 y, por esta última hasta San Antonio Oeste en la Provincia de Río Negro, en cuyo puerto finaliza esta delimitación."
  } ]
}, {
