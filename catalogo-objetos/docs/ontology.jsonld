  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "es",
    "@value" : "Son zonas de ecosistemas continentales (terrestres o acuáticos), costeros/marinos o marinos, o una combinación de los mismos, con límites definidos y bajo un marco normativo acorde con sus objetivos de conservación, que constituyen una estrategia fundamental para la conservación a largo plazo de la diversidad biológica y cultural, proporcionando bienes y servicios ecosistémicos esenciales para la sociedad y la vida en general. (SIFAP 2023)"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo" : [ {
