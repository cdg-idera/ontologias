    "@language" : "es",
    "@value" : "Sector estrecho de mar que separa dos porciones del mismo continente. Ejemplo: Canal de Beagle."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
