    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Tierras con limitaciones moderadas (erosión, drenaje, salinidad), que permiten cultivos con prácticas de manejo específicas."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Clase III"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "3"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Limitaciones moderadas a severas, que restringen la elección de cultivos y exigen prácticas de conservación más intensas."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/4",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Clase IV"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "4"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Limitaciones severas, aptas solo para pastoreo, forestación o algunos cultivos específicos con alto manejo."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/5",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Clase V"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "5"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Suelos con limitaciones muy severas; el uso es apto solo para pastoreo, forestación y no son aptos para agricultura."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/6",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Clase VI"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "6"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Limitaciones muy severas, aptas principalmente para pastoreo y forestación. La pedregosidad o la susceptibilidad a inundaciones son comunes."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/7",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Clase VII"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "7"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Limitaciones extremas, uso restringido a pastoreo y conservación, no para agricultura. Pueden tener pendientes pronunciadas o ser pedregosos."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/8",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Clase VIII"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "8"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente" : [ {
    "@language" : "es",
    "@value" : "Suelos no aptos para fines agrícolas o ganaderos, como desiertos. Su uso se limita a la conservación o actividades recreativas."
  } ]
}, {
  "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/-1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Información no disponible"
  } ],
  "https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio" : [ {
    "@value" : "-1"
  } ],
