                                                                         :codigoValorDominio "-1" ;
                                                                         :observacionFuente "Cuando no se dispone o no se tiene certeza de los datos."@es ;
                                                                         rdfs:label "Información no disponible"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SMC/46
