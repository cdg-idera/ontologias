#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://cdg-idera.github.io/ontologias/catalogo-objetos/correspondeAtributo
:correspondeAtributo rdf:type owl:ObjectProperty ;
                     rdfs:range :AtributoCatalogado ;
                     rdfs:comment "Relaciona una propiedad utilizada por una fuente de datos con el atributo semántico correspondiente del Catálogo IDERA."@es ;
                     rdfs:label "corresponde a atributo IDERA"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/defineClaseImplementable
:defineClaseImplementable rdf:type owl:ObjectProperty ;
                          rdfs:label "defineClaseImplementable"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/definePropiedadImplementable
:definePropiedadImplementable rdf:type owl:ObjectProperty ;
                              rdfs:label "definePropiedadImplementable"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/esAtributoDe
:esAtributoDe rdf:type owl:ObjectProperty ;
              rdfs:label "esAtributoDe"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/esClaseDe
:esClaseDe rdf:type owl:ObjectProperty ;
           owl:inverseOf :tieneClase ;
           rdfs:label "esClaseDe"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/esSubclaseDe
:esSubclaseDe rdf:type owl:ObjectProperty ;
              owl:inverseOf :tieneSubclase ;
              rdfs:label "esSubclaseDe"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/esValorDeDominioDe
:esValorDeDominioDe rdf:type owl:ObjectProperty ;
                    rdfs:label "esValorDeDominioDe"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/implementaAtributo
:implementaAtributo rdf:type owl:ObjectProperty ;
                    owl:inverseOf :definePropiedadImplementable ;
                    rdfs:label "implementaAtributo"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/implementaObjetoGeografico
:implementaObjetoGeografico rdf:type owl:ObjectProperty ;
                            owl:inverseOf :defineClaseImplementable ;
                            rdfs:label "implementaObjetoGeografico"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/perteneceASubclase
:perteneceASubclase rdf:type owl:ObjectProperty ;
                    owl:inverseOf :tieneObjetoGeografico ;
                    rdfs:label "perteneceASubclase"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tieneAtributo
:tieneAtributo rdf:type owl:ObjectProperty ;
               owl:inverseOf :esAtributoDe ;
               rdfs:label "tieneAtributo"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tieneClase
:tieneClase rdf:type owl:ObjectProperty ;
            rdfs:label "tieneClase"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tieneObjetoGeografico
:tieneObjetoGeografico rdf:type owl:ObjectProperty ;
                       rdfs:label "tieneObjetoGeografico"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tieneSubclase
:tieneSubclase rdf:type owl:ObjectProperty ;
               rdfs:label "tieneSubclase"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tieneValorDominio
:tieneValorDominio rdf:type owl:ObjectProperty ;
                   owl:inverseOf :esValorDeDominioDe ;
                   rdfs:label "tieneValorDominio"@es .


#################################################################
#    Data properties
#################################################################

###  https://cdg-idera.github.io/ontologias/catalogo-objetos/codigo
:codigo rdf:type owl:DatatypeProperty ;
        rdfs:label "código"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/codigoValorDominio
:codigoValorDominio rdf:type owl:DatatypeProperty ;
                    rdfs:label "código del valor de dominio"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/dbyf
:dbyf rdf:type owl:DatatypeProperty ;
      rdfs:label "DByF"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/observacionFuente
:observacionFuente rdf:type owl:DatatypeProperty ;
                   rdfs:label "observación de la fuente"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tieneDominio
:tieneDominio rdf:type owl:DatatypeProperty ;
              rdfs:label "tiene dominio"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tipoAtributo
:tipoAtributo rdf:type owl:DatatypeProperty ;
              rdfs:label "tipo de atributo"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/tipoGeometrico
:tipoGeometrico rdf:type owl:DatatypeProperty ;
                rdfs:label "tipo geométrico"@es .


