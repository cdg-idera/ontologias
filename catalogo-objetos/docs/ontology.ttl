#################################################################
#    Classes
#################################################################

###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado
:AtributoCatalogado rdf:type owl:Class ;
                    rdfs:comment "Atributo definido en el catálogo; corresponde conceptualmente a FC_FeatureAttribute de ISO 19110."@es ;
                    rdfs:label "Atributo catalogado"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/CatalogoObjetos
:CatalogoObjetos rdf:type owl:Class ;
                 rdfs:comment "Recurso que representa el catálogo de objetos geográficos."@es ;
                 rdfs:label "Catálogo de objetos geográficos"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo
:ClaseCatalogo rdf:type owl:Class ;
               rdfs:comment "Categoría organizativa de primer nivel del catálogo."@es ;
               rdfs:label "Clase del catálogo"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado
:ObjetoGeograficoCatalogado rdf:type owl:Class ;
                            rdfs:comment "Tipo de objeto geográfico definido en el catálogo; corresponde conceptualmente a FC_FeatureType de ISO 19110."@es ;
                            rdfs:label "Objeto Geográfico catalogado"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo
:SubclaseCatalogo rdf:type owl:Class ;
                  rdfs:comment "Categoría organizativa de segundo nivel del catálogo."@es ;
                  rdfs:label "Subclase del catálogo"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio
:ValorDominio rdf:type owl:Class ;
              rdfs:comment "Valor listado de un atributo; corresponde conceptualmente a FC_ListedValue de ISO 19110."@es ;
              rdfs:label "Valor de dominio"@es .


###  https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010101
<https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010101> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> .


