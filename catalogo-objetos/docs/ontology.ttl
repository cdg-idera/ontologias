                                                                    :tieneAtributo <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA> ,
                                                                                   <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA> ,
                                                                                   <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM> ,
                                                                                   <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NFC> ,
