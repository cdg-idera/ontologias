@prefix : <https://cdg-idera.github.io/ontologias/catalogo-objetos/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://cdg-idera.github.io/ontologias/catalogo-objetos/> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/> rdf:type owl:Ontology ;
                                                            owl:versionIRI <https://cdg-idera.github.io/ontologias/catalogo-objetos/version/2.2> ;
                                                            <http://purl.org/dc/terms/creator> "Luis Reynoso" ;
                                                            <http://purl.org/dc/terms/description> "Esta ontología proporciona una representación semántica del Catálogo de Objetos Geográficos de IDERA V2.2. Modela su estructura de clases, subclases, objetos geográficos, atributos y dominios, preservando la semántica definida por el catálogo. Su propósito es facilitar la identificación, vinculación y validación semántica de información geoespacial conforme al Catálogo IDERA, favoreciendo la interoperabilidad y la reutilización de sus conceptos en diferentes sistemas y aplicaciones."@es ;
                                                            <http://purl.org/dc/terms/issued> "2026-09-15"^^xsd:date ;
                                                            <http://purl.org/dc/terms/language> "es" ;
                                                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                            <http://purl.org/dc/terms/publisher> "Grupo de Trabajo Temático Ciencia de Datos Geoespaciales (GTT-CDG) de IDERA"@es ;
                                                            <http://purl.org/dc/terms/source> <https://www.idera.gob.ar/index.php/recursos/catalogo-de-og-y-dbyf> ;
                                                            <http://purl.org/dc/terms/title> "Ontología del Catálogo de Objetos Geográficos de IDERA"@es ;
                                                            owl:versionInfo "2.2" .

