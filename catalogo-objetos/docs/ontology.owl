        <rdfs:label xml:lang="es">Area militar</rdfs:label>
        <skos:definition xml:lang="es">Consigna el área militar en la que se encuentra el ex CCD</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/AZI -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/AZI">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/AZI"/>
        <codigo>AZI</codigo>
        <observacionFuente xml:lang="es">Unidad de medida: 
Grado (°)</observacionFuente>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Numérico</tipoAtributo>
        <rdfs:label xml:lang="es">Azimut</rdfs:label>
        <skos:definition xml:lang="es">Ángulo medido sobre el plano horizontal en el sentido de las agujas del reloj a partir de un meridiano de referencia. Lo más usual es utilizar el Norte (geográfico, magnético o arbitrario) y la línea. El valor angular varía entre  0° y 360°.</skos:definition>
    </owl:NamedIndividual>
    


