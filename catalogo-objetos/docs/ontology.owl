        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYM"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Extensión de territorio cuya superficie es mayor a 1.5 hectáreas y no supere las 12 hectáreas. (ARBA 2018)</observacionFuente>
        <rdfs:label xml:lang="es">Quinta</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYM/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYM/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYM"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Extensión de territorio cuya superficie es superior a 12 hectáreas y no excede 120 hectáreas, totalmente rodeadas de vías de comunicación. (ARBA 2018)</observacionFuente>
        <rdfs:label xml:lang="es">Chara</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYM/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYM/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
