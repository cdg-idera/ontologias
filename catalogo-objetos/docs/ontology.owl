        <codigoValorDominio>138</codigoValorDominio>
        <observacionFuente xml:lang="es">El material predominante es madera de cualquier tipo.</observacionFuente>
        <rdfs:label xml:lang="es">Madera</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/64 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/64">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
