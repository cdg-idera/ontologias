        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0208</codigo>
        <rdfs:label xml:lang="es">Salud</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con instalaciones destinadas a brindar atención sanitaria (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0209 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0209">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0209</codigo>
        <rdfs:label xml:lang="es">Tecnología Y Ciencia</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relativos a los establecimientos vinculados al desarrollo de actividades tecnológicas y científicas (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0210 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0210">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0210</codigo>
        <rdfs:label xml:lang="es">Derechos Humanos</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relativos a la promoción y protección de los Derechos Humanos  (Secretaria de DDHH Bs As - 2019)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0301 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0301">
