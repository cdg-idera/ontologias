    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TGG/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TGG/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TGG"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Nieve o hielo, de espesor variable, que dura todo el año, por arriba de la línea de las &quot;nieves eternas&quot; dependiendo de la latitud y altura orográfica. El límite climático del sistema orográfico de nieve y el espesor del recubrimiento, dependen de la posición geográfica y de los factores que inciden en los fenómenos locales.</observacionFuente>
        <rdfs:label xml:lang="es">Nieve o hielo permanente</rdfs:label>
    </owl:NamedIndividual>
    


