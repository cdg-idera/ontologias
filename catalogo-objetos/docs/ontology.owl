        <codigoValorDominio>64</codigoValorDominio>
        <observacionFuente xml:lang="es">El material predominante es hierro, aluminio u otros metales.</observacionFuente>
        <rdfs:label xml:lang="es">Metálico</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/77 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/77">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MCC"/>
        <codigoValorDominio>77</codigoValorDominio>
        <observacionFuente xml:lang="es">El material predominante es cemento, arena u otro árido, material de mortero, con un armazón de hierro.</observacionFuente>
        <rdfs:label xml:lang="es">Hormigón</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/9 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/9">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MCC"/>
        <codigoValorDominio>9</codigoValorDominio>
        <observacionFuente xml:lang="es">El material predominante es ladrillos colocados a mano.</observacionFuente>
        <rdfs:label xml:lang="es">Mampostería</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación de población para la adquisición de conocimientos, destrezas y capacidades que la estructura del sistema educativo prevé en los plazos preestablecidos y en las edades teóricas previstas. Contiene los niveles: Inicial, Primario / EGB1 y 2, EGB3, Medio / polimodal y Superior Universitario y Superior No Universitario (de formación docente y de formación técnico / profesional).</observacionFuente>
        <rdfs:label xml:lang="es">Común</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación de personas cuyos procesos de aprendizaje se ven dificultados por motivos de origen psico-físico y educativo particular, ya sea de manera transitoria o permanente. Contiene los niveles: Inicial, Primario / EGB1 y 2, EGB3, Medio / polimodal.</observacionFuente>
        <rdfs:label xml:lang="es">Especial</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Proceso educativo organizado por el cual jóvenes y adultos mejoran sus capacidades técnicas y profesionales, desarrollan sus habilidades o enriquecen sus conocimientos con los propósitos de completar un nivel de educación formal, adquirir o actualizar conocimiento y habilidades en un área específica. Contiene los niveles: Primario / EGB1 y 2, EGB3, Medio / polimodal.</observacionFuente>
        <rdfs:label xml:lang="es">Jóvenes y adultos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación que responde a la necesidad de aquellas personas que, a partir de diferentes motivaciones, inquietudes e iniciativas demandan educación en los diversos campos del arte. Contiene los niveles: Inicial, Primario / EGB1 y 2, EGB3, Medio / polimodal y Superior Universitario y Superior No Universitario (de formación docente y de formación técnico / profesional).</observacionFuente>
        <rdfs:label xml:lang="es">Artística</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación dirigida a población que requiere además de conocimientos curriculares generales, una formación en estudios orientados o formación permanente en áreas ocupacionales en los sectores de la vida económica. Abarca la formación básica hacia el mundo laboral, la formación de técnicos medios y técnicos superiores.</observacionFuente>
        <rdfs:label xml:lang="es">Técnico profesional</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación destinada a garantizar el derecho a la educación de personas en conflicto con la ley penal o en situación de encierro (institutos de menores, cárceles, centro de atención de adicciones u otros locales similares) de los niveles y servicios educativos: Inicial (atención educativa de los niños menores de 4 años cuyas madres se encuentran en unidades carcelarias) / Primario / Secundario / Superior No Universitario / otros Servicios (Formación Profesional).</observacionFuente>
        <rdfs:label xml:lang="es">En privación de libertad</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación que satisface, a través de proyectos institucionales o formas de organización escolar, necesidades de alumnos que concurren a unidades educativas ubicadas en entornos alejados del mosaico principal de una localidad. Tiene por objeto garantizar la obligatoriedad y la continuidad de los estudios en los niveles: Inicial / Primario / Secundario.</observacionFuente>
        <rdfs:label xml:lang="es">Rural</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/8 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/8">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>8</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación que atiende a alumnos pertenecientes a pueblos originarios o comunidades indígenas que por cuestiones culturales y / o lingüísticas requieren de un enfoque educativo propio. La modalidad intercultural bilingüe satisface estas particularidades en los siguientes servicios educativos: Inicial / Primario / Secundario.</observacionFuente>
        <rdfs:label xml:lang="es">Intercultural bilingüe</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/9 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDE/9">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDE"/>
        <codigoValorDominio>9</codigoValorDominio>
        <observacionFuente xml:lang="es">Educación destinada a población escolar de niveles obligatorios con el objeto de garantizar la continuidad de sus estudios y su reinserción en el sistema educativo que, por razones de salud, no puede concurrir con regularidad al establecimiento educativo. Está integrada por los niveles : Inicial / Primario / Secundario.</observacionFuente>
        <rdfs:label xml:lang="es">Domiciliaria y hospital</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDF"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDF"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Falla generada por  tensión  horizontal. Las  fuerzas inducidas en la roca son perpendiculares al acimut de la falla (línea de ruptura superficial), y el movimiento es predominantemente vertical respecto al plano de falla, el cual típicamente tiene un  ángulo  de  60º  respecto  a  la  horizontal.  El  bloque  que  se encuentra  por  encima  del plano de la falla se denomina techo, y se desliza hacia abajo; mientras que el bloque que se encuentra por debajo del plano de la falla se denomina piso, y asciende.</observacionFuente>
        <rdfs:label xml:lang="es">Falla normal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDF"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Falla generada por compresión horizontal. El movimiento es preferentemente  horizontal  y  el  plano  de  falla  tiene  típicamente  un  ángulo  de  30º respecto a la horizontal. El bloque de techo se encuentra sobre el bloque de piso. Cuando la falla  inversa  presenta  un buzamiento  (inclinación) inferior  a  45º, ésta también toma el nombre de cabalgamiento.</observacionFuente>
        <rdfs:label xml:lang="es">Falla inversa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MDF/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MDF"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Falla desarrollada  a  lo largo de un plano vertical, cuyo movimiento de bloques es horizontal. Es típica de límites transformantes  de  placas  tectónicas.  Se  distinguen  dos  tipos  de  fallas  de  desgarre: lateral derecha y  lateral izquierda. Lateral  derecha o  dextral,  es  aquella  en  donde  el movimiento  relativo  de  los  bloques  es  hacia  la  derecha; mientras  que  en  la lateral izquierda o  sinestral, el movimiento  es opuesto a  la  anterior.  También  se  la  conoce como falla transversal, de desgarre o de rumbo.</observacionFuente>
        <rdfs:label xml:lang="es">Falla de desplazamiento</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MEM/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MEM/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MEM"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MEM/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MEM/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MEM"/>
        <codigoValorDominio>1</codigoValorDominio>
        <rdfs:label xml:lang="es">Si</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MEM/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MEM/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MEM"/>
        <codigoValorDominio>2</codigoValorDominio>
        <rdfs:label xml:lang="es">No</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MES/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MES/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/MES"/>
        <codigoValorDominio>-1</codigoValorDominio>
