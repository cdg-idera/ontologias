        <codigoValorDominio>47</codigoValorDominio>
        <observacionFuente xml:lang="es">Vía con calzadas separadas y restricciones de uso para determinadas categorías de tráfico. Puede contar con semáforos y cruces peatonales.</observacionFuente>
        <rdfs:label xml:lang="es">Autovía</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/51 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/51">
