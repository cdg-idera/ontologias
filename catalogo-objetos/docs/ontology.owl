    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/102 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/102">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
