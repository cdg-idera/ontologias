        <codigo>110109</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Cementerio privado</rdfs:label>
        <skos:definition xml:lang="es">Se consideran cementerios privados a los inmuebles de propiedad privada afectados a la inhumación de restos humanos. Art. 2103 - CCCN - (UNCa - 2024)</skos:definition>
    </owl:NamedIndividual>
    


