        <codigoValorDominio>51</codigoValorDominio>
        <observacionFuente xml:lang="es">Vía de una sola calzada por donde se puede circular en un sólo sentido a la vez.</observacionFuente>
        <rdfs:label xml:lang="es">Camino de un carril</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/52 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/52">
