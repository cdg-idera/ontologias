        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Son extensiones de territorio cuya superficie no debe exceder las 1.5 hectáreas y están totalmente rodeadas de vías de comunicación. (ARBA 2018)</observacionFuente>
        <rdfs:label xml:lang="es">Manzana/macizo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYM/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYM/2">
