        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigo>051301</codigo>
        <dbyf>SI</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Área protegida</rdfs:label>
        <skos:definition xml:lang="es">Son zonas de ecosistemas continentales (terrestres o acuáticos), costeros/marinos o marinos, o una combinación de los mismos, con límites definidos y bajo un marco normativo acorde con sus objetivos de conservación, que constituyen una estrategia fundamental para la conservación a largo plazo de la diversidad biológica y cultural, proporcionando bienes y servicios ecosistémicos esenciales para la sociedad y la vida en general. (SIFAP 2023)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/051302 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/051302">
