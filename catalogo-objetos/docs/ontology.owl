        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Punto/Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Obstáculo para la navegación</rdfs:label>
        <skos:definition xml:lang="es">Elemento o condición que podría impedir, obstruir, poner en peligro o constituir de otro modo un peligro para la seguridad a la navegación. Incluye naufragio, roca, fondo sucio, rompiente, escarceo, entre otros. No incluye bajo, banco.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030501 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030501">
