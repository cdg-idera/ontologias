        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Yacimiento hidrocarburífero</rdfs:label>
        <skos:definition xml:lang="es">Cuerpo geológico aproximado, constituido por petróleo y / o gas, económicamente explotable.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/010102 -->


