        <rdfs:label xml:lang="es">Playa</rdfs:label>
        <skos:definition xml:lang="es">Área ribereña de mar, corriente de agua o espejo de agua, que por lo general se caracteriza por ser una superficie casi plana de arena, conchilla o grava.</skos:definition>
    </owl:NamedIndividual>
    


