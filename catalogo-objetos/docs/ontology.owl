        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAZ"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Inmuebles que cuentan con cercado perimetral de más de 1.20 mts. (más alto del tradicional) en los que puede desarrollarse también un sistema de cría intensiva.</observacionFuente>
        <rdfs:label xml:lang="es">Cerrado</rdfs:label>
    </owl:NamedIndividual>
    


