        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">No tienen especificaciones de ningún tipo dentro de la Ley 10707, es por ello que podemos  encontrarlas como macizos puros, o como subdivisiones de algún macizo puro. (ARBA 2018)</observacionFuente>
        <rdfs:label xml:lang="es">Fracción</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/-1 -->


