    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/correspondeAtributo -->


    <owl:ObjectProperty rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/correspondeAtributo">
        <rdfs:range rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <rdfs:comment xml:lang="es">Relaciona una propiedad utilizada por una fuente de datos con el atributo semántico correspondiente del Catálogo IDERA.</rdfs:comment>
        <rdfs:label xml:lang="es">corresponde a atributo IDERA</rdfs:label>
    </owl:ObjectProperty>
    


