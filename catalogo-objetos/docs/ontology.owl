    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041111 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041111">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/041111"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0411"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/THH"/>
        <codigo>041111</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Humedal</rdfs:label>
        <skos:definition xml:lang="es">Áreas del territorio que se caracterizan por la presencia temporaria o permanente de agua, suelos o sustratos característicos y biota adaptada a estas condiciones, comúnmente plantas hidrófitas. Incluye las extensiones de marismas, pantanos y turberas, o superficies cubiertas de aguas, sean éstas de régimen natural o artificial, permanentes o temporales, estancadas o corrientes, dulces, salobres o saladas, incluidas las extensiones de agua marina cuya profundidad en marea baja no exceda de seis metros.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041112 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041112">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/041112"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0411"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>041112</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Línea</tipoGeometrico>
        <rdfs:label xml:lang="es">Tajamar</rdfs:label>
        <skos:definition xml:lang="es">Obra que une dos laderas que se aproximan mediante una cortina de tierra bien apisonada, con el objetivo de detener el escurrimiento del agua de lluvia, formando un espejo de agua.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041113 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041113">
