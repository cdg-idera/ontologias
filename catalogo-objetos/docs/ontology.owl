        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Punto</tipoGeometrico>
        <rdfs:label xml:lang="es">Parador</rdfs:label>
        <skos:definition xml:lang="es">Predio a la vera de una vía de comunicación, con infraestructura de comedor, minimercados, duchas, descanso, estacionamientos y comunicaciones.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030805 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030805">
