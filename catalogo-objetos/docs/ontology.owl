    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDV -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDV">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/CDV"/>
        <codigo>CDV</codigo>
        <observacionFuente xml:lang="es">YYYY-MM-DDThh:mm:ssZ</observacionFuente>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Fecha y hora del evento</rdfs:label>
        <skos:definition xml:lang="es">Combinación de fecha y hora acorde al formato establecido en la Norma ISO 8601:2000 5.4.1, donde [AAAA] representa un año calendario, [MM] el número ordinal de un mes natural, en el año calendario, [DD] el número ordinal de un día dentro del mes calendario, [ hh] el número ordinal de una hora dentro del día natural, [mm] el número ordinal de un minuto antes de una hora, [ss] el número ordinal de un segundo en el minuto, y una &apos;Z&apos; opcional cuando el tiempo es de acuerdo al Tiempo universal Coordinado (UTC).</skos:definition>
    </owl:NamedIndividual>
    


