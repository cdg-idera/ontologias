        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NEN"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Están destinados a la formación y capacitación para el ejercicio de la docencia y a la formación superior de carácter instrumental en las áreas humanísticas, sociales, artísticas de formación Técnico Profesional regidas por la ley 26.058</observacionFuente>
        <rdfs:label xml:lang="es">Superior - Institutos no universitarios</rdfs:label>
    </owl:NamedIndividual>
    


