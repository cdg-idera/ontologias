        <codigoValorDominio>46</codigoValorDominio>
        <observacionFuente xml:lang="es">Material constituido por la acción de acumulación marina, de un tamaño de grano mayor a la arena.</observacionFuente>
        <rdfs:label xml:lang="es">Grava</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SMC/88 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SMC/88">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SMC"/>
        <codigoValorDominio>88</codigoValorDominio>
        <observacionFuente xml:lang="es">Material granulado formado por pequeños fragmentos erosionados de roca, cuyas partículas sedimentarias son más finas que la grava y más largas que un grano de limo grueso.</observacionFuente>
        <rdfs:label xml:lang="es">Arena</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SMC/89 -->


