    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAZ/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAZ/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAZ"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Inmuebles que cuentan con un cercado perimetral de altura tradicional de 1.20 mts. (7 hilos), que en su interior posean alguna estructura que permita efectuar un manejo más intensivo de los animales destinados a la caza.</observacionFuente>
        <rdfs:label xml:lang="es">Abierto</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAZ/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAZ/2">
