        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Línea</tipoGeometrico>
        <rdfs:label xml:lang="es">Pista</rdfs:label>
        <skos:definition xml:lang="es">Calzada rectangular de tierra o asfalto, definida en un campo de aviación o aeropuerto, utilizada para despegue y aterrizaje de aeronaves.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030504 -->


