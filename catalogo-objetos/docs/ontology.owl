    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAT/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAT/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAT"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Establecimiento que brinda servicio de alojamiento y otros complementarios, conforme a los requisitos que cada autoridad de aplicación indique para esta categoría (en cuanto a dimensiones de las unidades y espacios comunes, servicios esenciales, equipamiento y mobiliario), en habitaciones con baño privado y que ocupa la totalidad o parte independiente de un inmueble, constituyendo sus servicios y dependencias un todo homogéneo.</observacionFuente>
        <rdfs:label xml:lang="es">Hotel 1 estrella</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAT/10 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAT/10">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAT"/>
        <codigoValorDominio>10</codigoValorDominio>
        <observacionFuente xml:lang="es">Establecimiento que presta servicios semejantes al hotel y que por sus características, condiciones, instalaciones y servicios no puede ser considerado en la categoría mínima hotelera.</observacionFuente>
        <rdfs:label xml:lang="es">Hospedaje Turístico/Residencial Turístico</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAT/11 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CAT/11">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
