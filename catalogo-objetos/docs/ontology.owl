        <codigoValorDominio>38</codigoValorDominio>
        <observacionFuente xml:lang="es">Una plataforma que opera en la superficie de la columna de agua que se propulsa manualmente y no se puede quitar fácilmente.</observacionFuente>
        <rdfs:label xml:lang="es">Embarcación menor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/39 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/39">
