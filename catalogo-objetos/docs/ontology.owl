    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado -->


    <owl:Class rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado">
        <rdfs:comment xml:lang="es">Atributo definido en el catálogo; corresponde conceptualmente a FC_FeatureAttribute de ISO 19110.</rdfs:comment>
        <rdfs:label xml:lang="es">Atributo catalogado</rdfs:label>
    </owl:Class>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/CatalogoObjetos -->


    <owl:Class rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/CatalogoObjetos">
        <rdfs:comment xml:lang="es">Recurso que representa el catálogo de objetos geográficos.</rdfs:comment>
        <rdfs:label xml:lang="es">Catálogo de objetos geográficos</rdfs:label>
    </owl:Class>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo -->


    <owl:Class rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo">
        <rdfs:comment xml:lang="es">Categoría organizativa de primer nivel del catálogo.</rdfs:comment>
        <rdfs:label xml:lang="es">Clase del catálogo</rdfs:label>
    </owl:Class>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado -->


    <owl:Class rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado">
        <rdfs:comment xml:lang="es">Tipo de objeto geográfico definido en el catálogo; corresponde conceptualmente a FC_FeatureType de ISO 19110.</rdfs:comment>
        <rdfs:label xml:lang="es">Objeto Geográfico catalogado</rdfs:label>
    </owl:Class>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo -->


    <owl:Class rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo">
        <rdfs:comment xml:lang="es">Categoría organizativa de segundo nivel del catálogo.</rdfs:comment>
        <rdfs:label xml:lang="es">Subclase del catálogo</rdfs:label>
    </owl:Class>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio -->


    <owl:Class rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio">
