        <codigo>VDM</codigo>
        <observacionFuente xml:lang="es">Unidad de medida: Se especifica en el COG propio del organismo y en los metadatos</observacionFuente>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Numérico</tipoAtributo>
        <rdfs:label xml:lang="es">Valor de la muestra</rdfs:label>
        <skos:definition xml:lang="es">Indica el valor de la muestra obtenida</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VFQ -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VFQ">
