        <codigo>110202</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Pertenencia</rdfs:label>
        <skos:definition xml:lang="es">Extensión del terreno dentro de cuyos límites es posible realizar actividades de prospección. El terreno correspondiente a cada pertenencia se determina en superficie por líneas rectas, y en profundidad por planos verticales indicados por esas líneas.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110203 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110203">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/110203"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1102"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NEX"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/PPO"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>110203</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Punto</tipoGeometrico>
        <rdfs:label xml:lang="es">Manifestación de descubrimiento</rdfs:label>
        <skos:definition xml:lang="es">Localización de un criadero mineral a ser explorado. Se encuentra asociada a un área de exploración y constituye la causa originaria mas importante de adquisición de las concesiones mineras.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120101 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120101">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/120101"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1201"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CA3"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CFN"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>120101</codigo>
        <dbyf>SI</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Fracción censal</rdfs:label>
        <skos:definition xml:lang="es">Unidad operativa que subdivide un departamento en forma exhaustiva. Resulta de la adición de una determinada cantidad de radios completos definida para cada operativo censal. (INDEC 2025)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120102 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120102">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/120102"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1201"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CA3"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CRO"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TRO"/>
        <codigo>120102</codigo>
        <dbyf>SI</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Radio censal</rdfs:label>
        <skos:definition xml:lang="es">Unidad operativa que subdivide una fracción en forma exhaustiva y se define para cada operativo censal. Con fines estadísticos, el radio se clasifica en urbano, rural o mixto. (INDEC 2025)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120201 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120201">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/120201"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CA3"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CLC"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLC"/>
        <codigo>120201</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Punto /  Polígonos</tipoGeometrico>
        <rdfs:label xml:lang="es">Localidad Censal</rdfs:label>
        <skos:definition xml:lang="es">Unidad territorial caracterizada por la concentración espacial de edificaciones conectadas entre sí a través de una red de vías de circulación, terrestres o navegables. Se identifica por un nombre establecido por ley o costumbre. La delimitación de la localidad censal se realiza de acuerdo con el criterio de continuidad física. (INDEC 2025)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120202 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120202">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/120202"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CA3"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAG"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>120202</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Linea / Polìgono</tipoGeometrico>
        <rdfs:label xml:lang="es">Aglomerado</rdfs:label>
        <skos:definition xml:lang="es">Unidad territorial resultante de la agregación de dos o más localidades censales, que se extiende en dos o
más áreas político-administrativas, ya sean de primer o segundo nivel, o gobiernos locales. Si supera los 100.000 habitantes, Se antepone al nombre del aglomerado el término “Gran”.  (INDEC 2025)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120203 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120203">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/120203"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CEN"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>120203</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Punto / Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Entidad Censal</rdfs:label>
        <skos:definition xml:lang="es">Unidad territorial que identifica una subdivisión de la localidad censal dentro de una misma área político-administrativa. (INDEC 2025)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120204 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/120204">
