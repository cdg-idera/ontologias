    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/13 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/13">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>13</codigoValorDominio>
        <observacionFuente xml:lang="es">Estructura a la que se puede unir instrumentación que está en el aire o bajo el agua, según el estado de la marea y las condiciones climáticas.</observacionFuente>
        <rdfs:label xml:lang="es">Estructura de playa/intermareal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/16 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/16">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>16</codigoValorDominio>
        <observacionFuente xml:lang="es">Estructura artificial fija (durante la realizacion de las mediciones) alejada de la costa enla que se puede instalar instrumental (por ejemplo, una plataforma petrolera, una plataforma de gas o una barcaza autoelevable).</observacionFuente>
        <rdfs:label xml:lang="es">Instalacion/Estructura offshore (fuera de costa)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/17 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/17">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>17</codigoValorDominio>
        <observacionFuente xml:lang="es">Estructura fija permanentemente unida a la tierra con acceso al agua en todos los estados de la marea en la que se puede instalar instrumentos de medicion (por ejemplo, un muelle).</observacionFuente>
        <rdfs:label xml:lang="es">Estructura costera</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/20 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/20">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>20</codigoValorDominio>
        <observacionFuente xml:lang="es">Plataforma que opera en la columna de agua con propulsión limitada y sin operador humano a bordo.</observacionFuente>
        <rdfs:label xml:lang="es">Sumergible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/31 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/31">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>31</codigoValorDominio>
        <observacionFuente xml:lang="es">Plataforma de cualquier tamaño que opera en la superficie de la columna de agua  equipada, tripulada y operada específicamente para la investigación científica, generalmente oceanográfica.</observacionFuente>
        <rdfs:label xml:lang="es">Buque de investigación</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/32 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/32">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>32</codigoValorDominio>
        <observacionFuente xml:lang="es">Embarcación comercial de cualquier tamaño que recopila regularmente datos científicos (oceanográficos y meteorológicos).</observacionFuente>
        <rdfs:label xml:lang="es">Buque de oportunidad</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/33 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/33">
