<?xml version="1.0"?>
<rdf:RDF xmlns="https://cdg-idera.github.io/ontologias/catalogo-objetos/"
     xml:base="https://cdg-idera.github.io/ontologias/catalogo-objetos/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:catalogo-objetos="https://cdg-idera.github.io/ontologias/catalogo-objetos/">
    <owl:Ontology rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/">
        <owl:versionIRI rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/version/2.2"/>
        <terms:creator>Luis Reynoso</terms:creator>
        <terms:description xml:lang="es">Esta ontología proporciona una representación semántica del Catálogo de Objetos Geográficos de IDERA V2.2. Modela su estructura de clases, subclases, objetos geográficos, atributos y dominios, preservando la semántica definida por el catálogo. Su propósito es facilitar la identificación, vinculación y validación semántica de información geoespacial conforme al Catálogo IDERA, favoreciendo la interoperabilidad y la reutilización de sus conceptos en diferentes sistemas y aplicaciones.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-15</terms:issued>
        <terms:language>es</terms:language>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher xml:lang="es">Grupo de Trabajo Temático Ciencia de Datos Geoespaciales (GTT-CDG) de IDERA</terms:publisher>
        <terms:source rdf:resource="https://www.idera.gob.ar/index.php/recursos/catalogo-de-og-y-dbyf"/>
        <terms:title xml:lang="es">Ontología del Catálogo de Objetos Geográficos de IDERA</terms:title>
        <owl:versionInfo>2.2</owl:versionInfo>
    </owl:Ontology>
    


