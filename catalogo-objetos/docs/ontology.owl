        <rdfs:label xml:lang="es">Radiometro</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/130 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/130">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDM"/>
        <codigoValorDominio>130</codigoValorDominio>
        <observacionFuente xml:lang="es">Un instrumento reutilizable que siempre mide simultáneamente conductividad y temperatura (para salinidad) y presión (para profundidad)</observacionFuente>
        <rdfs:label xml:lang="es">CTD</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/132 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/132">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDM"/>
        <codigoValorDominio>132</codigoValorDominio>
        <observacionFuente xml:lang="es">Instrumentos que miden los perfiles verticales de la temperatura del mar ya sea bajando un paquete de sensor de presión más temperatura (MBT) o dejando caer un sensor desechable de caída libre (XBT).</observacionFuente>
        <rdfs:label xml:lang="es">Batitermografos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/133 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/133">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
