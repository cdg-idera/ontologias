        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0205</codigo>
        <rdfs:label xml:lang="es">Política Y Administración</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con la política y / o que describen cuestiones administrativas (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0206 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0206">
