        <codigo>040301</codigo>
        <dbyf>SI</dbyf>
        <tipoGeometrico xml:lang="es">Línea</tipoGeometrico>
        <rdfs:label xml:lang="es">Curva batimétrica</rdfs:label>
        <skos:definition xml:lang="es">Línea trazada en un espejo de agua, corriente de agua, mar u océano, que une puntos de igual profundidad respecto de un nivel de referencia definido. También se la denomina isobata.</skos:definition>
    </owl:NamedIndividual>
    


