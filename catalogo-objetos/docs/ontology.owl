    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/051101 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/051101">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/051101"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0511"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ARA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
