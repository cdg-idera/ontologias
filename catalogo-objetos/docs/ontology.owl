    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ACC -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ACC">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/ACC"/>
        <codigo>ACC</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Accesibilidad</rdfs:label>
        <skos:definition xml:lang="es">Posibilidad de las personas con movilidad reducida de gozar de las adecuadas condiciones de seguridad y autonomía para utilizar la infraestructura sin restricciones derivadas del ámbito arquitectónico (Ley Nacional N° 24.314) - (INFUETRUR 2024)</skos:definition>
    </owl:NamedIndividual>
    


