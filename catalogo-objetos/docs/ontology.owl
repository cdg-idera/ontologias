        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VFQ"/>
        <codigo>VFQ</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Variable fìsico/quimica</rdfs:label>
        <skos:definition xml:lang="es">Indicacion de la variable fisico/quimica representada</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VLJ -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VLJ">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VLJ"/>
        <codigo>VLJ</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Validación de límite interprovincial</rdfs:label>
        <skos:definition xml:lang="es">Tipo de validación de un límite entre provincias.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VLP -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VLP">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VLP"/>
        <codigo>VLP</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Validación de límite</rdfs:label>
        <skos:definition xml:lang="es">Tipo de validación de un límite. No incluye los límites entre provincias.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VOA -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VOA">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VOA"/>
        <codigo>VOA</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Actividad volcánica</rdfs:label>
        <skos:definition xml:lang="es">Período en que se registró la última actividad volcánica.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VOL -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VOL">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VOL"/>
        <codigo>VOL</codigo>
        <observacionFuente xml:lang="es">No consta en la hoja LISTA DE ATRIBUTOS del Catálogo IDERA V2.2.</observacionFuente>
        <rdfs:label xml:lang="es">Volumen</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VPR -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VPR">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VPR"/>
        <codigo>VPR</codigo>
        <observacionFuente xml:lang="es">No consta en la hoja LISTA DE ATRIBUTOS del Catálogo IDERA V2.2.</observacionFuente>
        <rdfs:label xml:lang="es">Valor de la propiedad</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/WSC -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/WSC">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/WSC"/>
        <codigo>WSC</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Tipo de residuo domiciliario</rdfs:label>
        <skos:definition xml:lang="es">(Waste/Scrap Type Category - DFDD) Clasificación del tipo de residuo domiciliario</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ZNM -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ZNM">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/ZNM"/>
        <codigo>ZNM</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Zona militar</rdfs:label>
        <skos:definition xml:lang="es">Consigna la zona militar en la que se encuentra el ex CCD</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>01</codigo>
        <rdfs:label xml:lang="es">Industria Y Servicios</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos relacionados con la extracción y procesamiento de recursos naturales, producción agropecuaria, minería, industrialización, energía, comunicaciones, almacenamiento y logística, tratamiento y gestión de los residuos (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>02</codigo>
        <rdfs:label xml:lang="es">Infraestructura Social</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos que se relacionan en el sentido más amplio con los aspectos sociales de la población. A esta clase pertenecen los dominios de la administración, el comercio, el turismo, el ocio, la educación, la cultura, la salud y la ciencia (IDERA, 2018 - INFUETUR 2024).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>03</codigo>
        <rdfs:label xml:lang="es">Transporte</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos que se relacionan con el conjunto de instalaciones fijas, entidades de flujo y un sistema de control que permiten que personas y  bienes venzan la fricción del espacio geográfico &apos;eficientemente&apos; a efectos de participar oportunamente en alguna actividad deseada (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>04</codigo>
        <rdfs:label xml:lang="es">Hidrografía Y Oceanografía</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos naturales y artificiales relacionados a los ambientes marino, fluvial y lacustre. Incluye las características físicas y químicas del agua, la biología marina y la geología marina (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>05</codigo>
        <rdfs:label xml:lang="es">Geografía Física</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos que se relacionan con las formas del relieve terrestre, los suelos y su cobertura (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>06</codigo>
        <rdfs:label xml:lang="es">Biota</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos asociados a la distribución de los seres vivos (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>07</codigo>
        <rdfs:label xml:lang="es">Demarcación</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos territoriales legales que se relacionan con las fronteras y los límites políticos, administrativos y de hecho (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/09 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/09">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>09</codigo>
        <rdfs:label xml:lang="es">Defensa Y Seguridad</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos inherentes a las instalaciones militares o a las estructuras de las operaciones militares (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>10</codigo>
        <rdfs:label xml:lang="es">Clima Y Meteorología</rdfs:label>
        <skos:definition xml:lang="es">Clasifica subcategorías que reúnen información climática y meteorológica (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>11</codigo>
        <rdfs:label xml:lang="es">Catastro</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos  territoriales legales que pertenecen a un determinado país o distrito, correspondientes a un inventario público, metódicamente ordenado, que contiene datos concernientes a los mismos y que se determinan a partir de actos de levantamientos territoriales. La unidad de registración del catastro es la parcela (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>12</codigo>
        <rdfs:label xml:lang="es">Unidades Geoestadísticas</rdfs:label>
        <skos:definition xml:lang="es">Comprende los objetos geográficos que definen áreas estadísticas de desagregación del territotio nacional, provincial y de áreas de gobierno local. Se utilizan tanto para el relevamiento como para la publicación de resultados, y son comparables intercensalmente a pesar de la dinámica de distribución de la población (INDEC, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/23 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/23">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ClaseCatalogo"/>
        <esClaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/catalogo-v2-2"/>
        <codigo>23</codigo>
        <rdfs:label xml:lang="es">Abstracto</rdfs:label>
        <skos:definition xml:lang="es">Este subgrupo consta de conceptos que se utilizan para modelar información sobre tipos de fenómenos, pero que en sí mismos no representan fenómenos. (Adaptación del DFDD) - IDESoB 2024</skos:definition>
    </owl:NamedIndividual>
    


