        <rdfs:label xml:lang="es">Estación de servicio</rdfs:label>
        <skos:definition xml:lang="es">Instalación ubicada a la vera de una vía de comunicación, destinada a la provisión de combustible y asistencia mecánica a automotores.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030802 -->


