        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FRI"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Establecimiento de alto nivel higiénico-sanitario. Cumple con estándares internacionales que lo habilita a exportar a la Unión Europea y a los mercados más exigentes.</observacionFuente>
        <rdfs:label xml:lang="es">Clase A</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/FRI/2 -->


