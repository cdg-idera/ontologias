        <tipoGeometrico xml:lang="es">Punto</tipoGeometrico>
        <rdfs:label xml:lang="es">Guardaganado</rdfs:label>
        <skos:definition xml:lang="es">Reja de hierro o madera colocada transversalmente sobre un lugar de tránsito vial, para impedir el paso del ganado.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030709 -->


