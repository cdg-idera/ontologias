        <observacionFuente xml:lang="es">Son construcciones o intervenciones que permiten el desarrollo de productos o actividades turísticas: miradores, refugios turísticos, pasarelas</observacionFuente>
        <rdfs:label xml:lang="es">Unidades de ordenamiento de visitación</rdfs:label>
    </owl:NamedIndividual>
    


