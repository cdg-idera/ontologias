        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>33</codigoValorDominio>
        <observacionFuente xml:lang="es">Pequeña embarcacion a motor y que se puede sacar fácilmente del agua (p. ej., semirrígidas, botes).</observacionFuente>
        <rdfs:label xml:lang="es">Embarcacion a motor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/36 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/36">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TPE"/>
        <codigoValorDominio>36</codigoValorDominio>
        <observacionFuente xml:lang="es">Plataforma que opera en la superficie de la columna de agua cuyo objetivo principal es la recolección comercial de peces o mariscos, pero que puede estar involucrada en actividades científicas.</observacionFuente>
        <rdfs:label xml:lang="es">Barco pesquero</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/38 -->


