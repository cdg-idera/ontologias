        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/TYA"/>
        <codigo>TYA</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Tipo de asentamiento</rdfs:label>
        <skos:definition xml:lang="es">Clasificación del tipo de asentamiento según su ubicación y composición.(BAHRA)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYM -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYM">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/TYM"/>
        <codigo>TYM</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Tipo de macizo</rdfs:label>
        <skos:definition xml:lang="es">Clasificación del tipo de macizo según su tamaño y/o su ubicación</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYP -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYP">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/TYP"/>
        <codigo>TYP</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Tipo de vía de transporte</rdfs:label>
        <skos:definition xml:lang="es">Clasificación de la vía de transporte en base a su diseño constructivo. Se refiere a los carriles, su distribución y características complementarias.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TZ1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TZ1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/TZ1"/>
        <codigo>TZ1</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Denominación de zona de frontera</rdfs:label>
        <skos:definition xml:lang="es">Denominación de la zona adyacente al límite internacional, que constituye una zona de seguridad destinada a complementar las previsiones territoriales de la defensa nacional y/o un área prioritaria para su desarrollo.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TZZ -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TZZ">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/TZZ"/>
        <codigo>TZZ</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Tipo de zona de frontera</rdfs:label>
        <skos:definition xml:lang="es">Clasificación de la zona adyacente al límite internacional, que constituye una zona de seguridad destinada a complementar las previsiones territoriales de la defensa nacional y/o un área prioritaria para su desarrollo.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/UDR -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/UDR">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/UDR"/>
        <codigo>UDR</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Unidad de Riego</rdfs:label>
        <skos:definition xml:lang="es">Clasificación de las tierras según sus limitantes y aptitudes para riego.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/UDS -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/UDS">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/UDS"/>
        <codigo>UDS</codigo>
        <tieneDominio>SI</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Uso del suelo</rdfs:label>
        <skos:definition xml:lang="es">Zonificación en función de la actividad predominante.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ULV -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ULV">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/ULV"/>
        <codigo>ULV</codigo>
        <observacionFuente xml:lang="es">AAAA-MM-DD</observacionFuente>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Cadena de caracteres</tipoAtributo>
        <rdfs:label xml:lang="es">Última visita</rdfs:label>
        <skos:definition xml:lang="es">Fecha de la última visita realizada al punto geodésico,  acorde al formato establecido en la Norma ISO 8601:2000 5.2.1.1, donde [AAAA] representa un año calendario, [MM] el número ordinal de un mes natural en el año calendario, [DD] el número ordinal de un día dentro del mes calendario.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VDA -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VDA">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VDA"/>
        <codigo>VDA</codigo>
        <observacionFuente xml:lang="es">Unidad de medida: 
milímetros (mm)</observacionFuente>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Numérico</tipoAtributo>
        <rdfs:label xml:lang="es">Valor de isohieta</rdfs:label>
        <skos:definition xml:lang="es">Valor de la línea que une puntos de igual precipitación media anual en un determinado período de tiempo.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VDI -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VDI">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/VDI"/>
        <codigo>VDI</codigo>
        <observacionFuente xml:lang="es">Unidad de medida: 
Grados centígrados (°C)</observacionFuente>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Numérico</tipoAtributo>
        <rdfs:label xml:lang="es">Valor de isoterma</rdfs:label>
        <skos:definition xml:lang="es">Valor de la línea que une puntos de igual temperatura media anual en un determinado período de tiempo.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VDM -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/VDM">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
