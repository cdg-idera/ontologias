        <codigo>100306</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Zona según frecuencia anual media de granizadas</rdfs:label>
        <skos:definition xml:lang="es">Área definida en función del la ocurrencia media de granizadas.</skos:definition>
    </owl:NamedIndividual>
    


