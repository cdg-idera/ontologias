    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0101 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0101">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0101</codigo>
        <rdfs:label xml:lang="es">Extracción</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con la extracción de materia prima, incluyendo agua e hidrocarburos (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0102 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0102">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0102</codigo>
        <rdfs:label xml:lang="es">Fabricación Y Procesamiento</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con el procesamiento de materia prima y la obtención de bienes, incluyendo el tratamiento del agua (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0103 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0103">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0103</codigo>
        <rdfs:label xml:lang="es">Actividad Agropecuaria</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos asociados a actividades productivas y económicas del sector agrícola y ganadero y sus derivados. (UNTREF 2023 - MAGyP 2025)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0104 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0104">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0104</codigo>
        <rdfs:label xml:lang="es">Energía</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con la producción, transporte y distribución de energía eléctrica (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0105 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0105">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0105</codigo>
        <rdfs:label xml:lang="es">Comunicaciones</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se refieren a todo tipo de infraestructura y servicios asociados a las comunicaciones tales como estructuras, redes y conexiones. (UNTREF 2023)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0106 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0106">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0106</codigo>
        <rdfs:label xml:lang="es">Estructura Asociada</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con estructuras de apoyo asociadas a la Clase Industria y servicios (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0107 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0107">
