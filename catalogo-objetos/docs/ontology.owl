        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0201</codigo>
        <rdfs:label xml:lang="es">Asentamiento</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con centros poblados, sitios y lugares que revisten un interés particular (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0202 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0202">
