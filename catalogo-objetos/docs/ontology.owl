    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/54 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/54">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYP"/>
        <codigoValorDominio>54</codigoValorDominio>
