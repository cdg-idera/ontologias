        <codigoValorDominio>22</codigoValorDominio>
        <observacionFuente xml:lang="es">Red de malla fina diseñada para recolectar organismos de tamaño pequeño, en la columna de agua (ej. microzooplancton, mesozooplancton, necton, microplásticos u otros desechos).</observacionFuente>
        <rdfs:label xml:lang="es">Redes de plankton</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/30 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/30">
