        <rdfs:label xml:lang="es">Parcela</rdfs:label>
        <skos:definition xml:lang="es">Extensión territorial continua, deslindada por un polígono de límites conocidos, perteneciente a un propietario.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110102 -->


