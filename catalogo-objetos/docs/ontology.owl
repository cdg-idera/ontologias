        <rdfs:label xml:lang="es">Circunscripción</rdfs:label>
        <skos:definition xml:lang="es">Polígonos en los que un Partido (Departamento) se subdivide, pudiendo contener en conjunto o separadamente plantas urbanas, suburbanas y rurales (ARBA,2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110105 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110105">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/110105"/>
