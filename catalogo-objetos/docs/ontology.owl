        <codigoValorDominio>133</codigoValorDominio>
        <observacionFuente xml:lang="es">Sensores de temperatura y conductividad instalados en una embarcación que miden en continuo la capa superficial del agua.</observacionFuente>
        <rdfs:label xml:lang="es">Termosalinografo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/134 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/134">
