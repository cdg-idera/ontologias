        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TCC"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Corresponde a una cima coronada por un afloramiento rocoso, de cualquier naturaleza, generalmente escarpada, lo cual no permite su representación altimétrica por curvas de nivel.</observacionFuente>
        <rdfs:label xml:lang="es">Cumbre rocosa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TCC/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TCC/3">
