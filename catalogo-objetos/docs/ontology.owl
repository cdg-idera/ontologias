    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLC/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLC/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLC"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Son aquellas que se extienden íntegramente sobre una jurisdicción de 2º orden y también sobre una sola área de gobierno local.</observacionFuente>
        <rdfs:label xml:lang="es">Simple</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLC/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLC/2">
