        <tipoGeometrico xml:lang="es">Punto/Línea</tipoGeometrico>
        <rdfs:label xml:lang="es">Badén</rdfs:label>
        <skos:definition xml:lang="es">Piso artificial de roca u hormigón construido sobre el fondo natural de una corriente de agua o espejo de agua para facilitar su cruce.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030706 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030706">
