        <skos:definition xml:lang="es">Limite, variable en tiempo y espacio, entre dos masas de agua de características fisicas diferentes (DFDD)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041202 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041202">
