        <codigoValorDominio>114</codigoValorDominio>
        <observacionFuente xml:lang="es">Instrumento que mide la velocidad y dirección de la corriente a una sola profundidad.</observacionFuente>
        <rdfs:label xml:lang="es">Correntometro</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/115 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/115">
