        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0107</codigo>
        <rdfs:label xml:lang="es">Almacenamiento Y Logística</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con el almacenamiento, protección, distribución y provisión de cualquier tipo de bien (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0108 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0108">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0108</codigo>
        <rdfs:label xml:lang="es">Gestión De Residuos</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos asociados a la recolección, tratamiento, reciclado y disposición de residuos (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0109 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0109">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01"/>
        <codigo>0109</codigo>
        <rdfs:label xml:lang="es">Actividad Cinegética</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relacionados a la práctica de la caza de animales en estado salvaje o silvestre, con o sin fines de lucro.(IDELP  2022 - UNTREF 2023)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0201 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0201">
