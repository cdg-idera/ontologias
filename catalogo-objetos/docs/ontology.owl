        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Son aquellas que se extienden sobre dos o más áreas político administrativas.</observacionFuente>
        <rdfs:label xml:lang="es">Compuesta</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Punto o zona elevada respecto a su entorno.</observacionFuente>
        <rdfs:label xml:lang="es">Alto</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Depresión u hondonada del terreno, que puede o no tener agua.</observacionFuente>
        <rdfs:label xml:lang="es">Bajo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Planicie enmarcada por cordones o sierras, de extensión variable, suelos áridos y vegetación xerófila.</observacionFuente>
        <rdfs:label xml:lang="es">Llano</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Región extensa de escaso relieve, donde las pendientes son muy bajas (%°) y el relieve plano-cóncavo-convexo es evidenciado por el diseño meándrico de los cursos que drenan la región con una velocidad de escurrimiento lenta.</observacionFuente>
        <rdfs:label xml:lang="es">Llanura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Nombre quechua que significa planicie sin árboles, para referirse a las extensas llanuras que componen gran parte de Argentina. Altiplanicie que constituye la parte superior de una meseta.</observacionFuente>
        <rdfs:label xml:lang="es">Pampa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">Superficie con una cobertura sedimentaria y notoria planitud en su configuración.</observacionFuente>
        <rdfs:label xml:lang="es">Planicie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">Extensión con escaso relieve y elevada altitud, que se encuentra generalmente localizada entre dos o más cadenas montañosas, pero cuyo levantamiento no ocurrió al mismo tiempo. También suele denominarse altiplanicie.</observacionFuente>
        <rdfs:label xml:lang="es">Altiplano</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/8 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLG/8">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLG"/>
        <codigoValorDominio>8</codigoValorDominio>
        <observacionFuente xml:lang="es">Voz quechua que significa &quot;tierras altas de la Cordillera&quot;. Altiplanicie ubicada entre los 3.000 a 4.000 msnm, rodeada de montañas.</observacionFuente>
        <rdfs:label xml:lang="es">Puna</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLQ/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLQ/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLQ"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLQ/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLQ/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLQ"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">También llamada hard breakline. Es aquella que representa una discontinuidad abrupta  (ejemplo: corriente de agua) en la pendiente de la superficie.</observacionFuente>
        <rdfs:label xml:lang="es">Dura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLQ/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TLQ/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TLQ"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">También llamada soft breakline. Es aquella que permite añadir mayor definición al modelo en zonas donde, aunque no cambia de forma abrupta la orientación de la pendiente, se recoge la forma de algún elemento determinado.</observacionFuente>
        <rdfs:label xml:lang="es">Blanda</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TP1"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TP1"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Extremo Norte del eje de rotación terrestre, donde convergen los meridianos, coincidiendo con las máximas latitudes.</observacionFuente>
        <rdfs:label xml:lang="es">Polo Norte geográfico</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TP1"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Punto ubicado en el hemisferio Norte donde convergen las líneas de fuerza del campo magnético terrestre.</observacionFuente>
        <rdfs:label xml:lang="es">Polo Norte magnético</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TP1"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Extremo Sur del eje de rotación terrestre, donde convergen los meridianos, coincidiendo con las máximas latitudes.</observacionFuente>
        <rdfs:label xml:lang="es">Polo Sur geográfico</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TP1/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TP1"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Punto ubicado en el hemisferio Sur donde convergen las líneas de fuerza del campo magnético terrestre.</observacionFuente>
        <rdfs:label xml:lang="es">Polo Sur magnético</rdfs:label>
    </owl:NamedIndividual>
    


