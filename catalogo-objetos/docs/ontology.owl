        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0304</codigo>
        <rdfs:label xml:lang="es">Fluvial, Marítimo Y Lacustre</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relacionados con el transporte a través de lagos, ríos, mares, océanos, canales o en otros cuerpos de agua continentales. (UNTREF 2023)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0305 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0305">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0305</codigo>
        <rdfs:label xml:lang="es">Aéreo</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con el transporte por aire y la infraestructura relacionada (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0306 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0306">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0306</codigo>
        <rdfs:label xml:lang="es">Controles</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan al control del transporte (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0307 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0307">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0307</codigo>
        <rdfs:label xml:lang="es">Cruces Y Enlaces</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos vinculados a obras de ingeniería relacionadas al transporte, cuya función es facilitar la circulación (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0308 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0308">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0308</codigo>
        <rdfs:label xml:lang="es">Infraestructura De Transporte</rdfs:label>
        <skos:definition xml:lang="es">Obras de la ingeniería que permitan el desarrollo del sistema de tránsito y transporte. (UNTREF 2023)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0401 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0401">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04"/>
        <codigo>0401</codigo>
        <rdfs:label xml:lang="es">Costas Y Zonas Litorales</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos correspondientes a las costas y zonas del litoral marítimo, fluvial y lacustre (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0403 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0403">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04"/>
        <codigo>0403</codigo>
        <rdfs:label xml:lang="es">Profundidades</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que representan la profundidad en espejos de agua, corrientes de agua, mares y océanos (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0406 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0406">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04"/>
        <codigo>0406</codigo>
        <rdfs:label xml:lang="es">Mareas Y Corrientes</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relacionados con la medición de mareas, corrientes de agua y canales (IGN, 2015). Incluye instalaciones de monitoreo (INIDEP 2022)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0411 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0411">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04"/>
        <codigo>0411</codigo>
        <rdfs:label xml:lang="es">Aguas Continentales</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con el agua que fluye o se almacena sobre la corteza terrestre. Incluye objetos geográficos naturales y obras para su gestión y manejo (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0412 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0412">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04"/>
        <codigo>0412</codigo>
        <rdfs:label xml:lang="es">Condiciones Oceanográficas</rdfs:label>
        <skos:definition xml:lang="es">Este Subgrupo consta de Conceptos que describen las condiciones físicas y químicas del agua, por ejemplo temperatura o densidad. (Adaptacion del DFDD)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0501 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0501">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0501</codigo>
        <rdfs:label xml:lang="es">Hipsografía</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que describen la forma (posiciones y alturas) de la superficie del terreno (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0502 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0502">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0502</codigo>
        <rdfs:label xml:lang="es">Geomorfología</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se refieren a las geoformas del relieve terrestre y sus características a excepción de las de origen glaciario (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0504 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0504">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0504</codigo>
        <rdfs:label xml:lang="es">Edafología</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que hacen referencia a diferentes tipos de suelos y sus características (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0506 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0506">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0506</codigo>
        <rdfs:label xml:lang="es">Vulcanismo Y Sismicidad</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos  relacionados a la actividad sísmica y a la actividad volcánica (IDERA, 2015). Se entiende por vulcanismo al fenómeno de erupción de magma donde la lava, piroclastos y gases volcánicos son eruptados a través de un conducto de la superficie de la Tierra. (SEGEMAR, 2019).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0507 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0507">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0507</codigo>
        <rdfs:label xml:lang="es">Glaciología</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con reservas hídricas estratégicas en estado sólido, nieve, hielo y otras geoformas de origen glaciario (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0510 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0510">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0510</codigo>
        <rdfs:label xml:lang="es">Geología</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que hacen referencia a diferentes tipos de roca, según sus propiedades y edad; sus relaciones de contacto y estructuras geológicas (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0511 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0511">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0511</codigo>
        <rdfs:label xml:lang="es">Ecorregiones</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que hacen referencia a territorios geográficamente definidos en los que dominan determinadas condiciones geomorfológicas y climáticas relativamente uniformes o recurrentes, caracterizados por una fisonomía vegetal de comunidades naturales y seminaturales que comparten un grupo considerable de especies dominantes, una dinámica y condiciones ecológicas generales cuyas interacciones son indispensables para su persistencia a largo plazo (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0512 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0512">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0512</codigo>
        <rdfs:label xml:lang="es">Degradación De Tierras Y Desertificación</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se refieren a la degradación de las tierras secas, fenómeno originado por las actividades humanas y las variaciones en el clima (CNULD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0513 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0513">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05"/>
        <codigo>0513</codigo>
        <rdfs:label xml:lang="es">Áreas De Conservación Y Manejo Sustentable</rdfs:label>
        <skos:definition xml:lang="es">Son zonas de ecosistemas continentales (terrestres o acuáticos), costeros/marinos o marinos, o una combinación de los mismos, con límites definidos y bajo un marco normativo acorde con sus objetivos de conservación, que constituyen una estrategia fundamental para la conservación a largo plazo de la diversidad biológica y cultural, proporcionando bienes y servicios ecosistémicos esenciales para la sociedad y la vida en general. (MAyDS 2023)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0601 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0601">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06"/>
        <codigo>0601</codigo>
        <rdfs:label xml:lang="es">Áreas De Cultivo</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relacionados a áreas terrestres cultivadas y / o manejadas (LCCS FAO, INTA).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0602 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0602">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06"/>
        <codigo>0602</codigo>
        <rdfs:label xml:lang="es">Áreas De Vegetación Natural Herbácea</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos referidos a áreas naturales y seminaturales con vegetación herbácea. Estas áreas pueden ser de vegetación predominantemente terrestre o predominantemente acuáticas (LCCS FAO, INTA).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0603 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0603">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06"/>
        <codigo>0603</codigo>
        <rdfs:label xml:lang="es">Áreas De Vegetación Natural Arbórea</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos referidos a áreas naturales y seminaturales con vegetación arbórea. Estas áreas pueden ser de vegetación predominantemente terrestre o predominantemente acuáticas (LCCS FAO, INTA).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0609 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0609">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06"/>
        <codigo>0609</codigo>
        <rdfs:label xml:lang="es">Áreas De Vegetación Natural Arbustiva</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos referidos a áreas naturales y seminaturales con vegetación arbustiva. Estas áreas pueden ser de vegetación predominantemente terrestre o predominantemente acuáticas (LCCS FAO, INTA).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0701 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0701">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07"/>
        <codigo>0701</codigo>
        <rdfs:label xml:lang="es">Fronteras Y Límites</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con la demarcación de diferentes tipos de límites entre jurisdicciones (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0703 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0703">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07"/>
        <codigo>0703</codigo>
        <rdfs:label xml:lang="es">Redes Geodésicas</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que materializan puntos sobre la superficie terrestre que poseen coordenadas geográficas (latitud, longitud) y altura sobre el nivel medio del mar, o valores de gravedad. Los puntos materializados se denominan pilares o mojones. Un grupo de pilares conforma una red geodésica (IGN, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0704 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0704">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07"/>
        <codigo>0704</codigo>
        <rdfs:label xml:lang="es">Puntos Y Líneas Terrestres</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos correspondientes a las líneas y puntos referenciales y principales del sistema de coordenadas terrestres (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0705 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0705">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07"/>
        <codigo>0705</codigo>
        <rdfs:label xml:lang="es">Planeamiento Urbano</rdfs:label>
        <skos:definition xml:lang="es">Objetos territoriales legales definidos por un Código de Planeamiento Urbano que alcanzan y rigen aquellos asuntos relacionados directa o indirectamente con el uso del suelo, de edificios, estructuras e instalaciones, apertura y ensanche de vías públicas, subdivisión y englobamiento de parcelas, volúmenes edificables, tejido urbano, preservación de ámbitos históricos, arquitectónicos, ambientales y paisajísticos y con aquellos aspectos que tengan relación con el ordenamiento urbanístico del territorio de la Ciudad (AGC Catamarca, 2016).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0901 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0901">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/09"/>
        <codigo>0901</codigo>
        <rdfs:label xml:lang="es">Infraestructura De Defensa</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se refieren a las instalaciones militares y a las estructuras operativas (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1001 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1001">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10"/>
        <codigo>1001</codigo>
        <rdfs:label xml:lang="es">Fenómenos Meteorológicos</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que describen fenómenos meteorológicos relativamente estables como las condiciones del viento (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1002 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1002">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10"/>
        <codigo>1002</codigo>
        <rdfs:label xml:lang="es">Condiciones Del Clima</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que describen las condiciones climáticas como la temperatura o la precipitación (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1003 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1003">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10"/>
        <codigo>1003</codigo>
        <rdfs:label xml:lang="es">Zonas Y Regiones Climáticas</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que describen zonas y / o regiones de clima con las condiciones climáticas especiales (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1101 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1101">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11"/>
        <codigo>1101</codigo>
        <rdfs:label xml:lang="es">Parcelario</rdfs:label>
        <skos:definition xml:lang="es">Objetos territoriales legales relacionados con datos concernientes a los objetos territoriales legales de un determinado país o distrito, basado en la mensura de sus límites, metódicamente ordenados (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1102 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1102">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11"/>
        <codigo>1102</codigo>
        <rdfs:label xml:lang="es">Minero</rdfs:label>
        <skos:definition xml:lang="es">Objetos territoriales legales relacionados al registro público de los Derechos Mineros existentes. Éste mantiene el registro y documentos inherentes de la identificación, ubicación, extensión, tipo y propiedad de las áreas afectadas de solicitudes y derechos mineros. Se encuentra organizado para cumplir funciones fiscales, jurídicas y administrativas (AGC Catamarca, 2016).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1201 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1201">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12"/>
        <codigo>1201</codigo>
        <rdfs:label xml:lang="es">Divisiones Censales</rdfs:label>
        <skos:definition xml:lang="es">Comprende el conjunto de divisiones del territorio diseñadas por el INDEC que permiten aseguran la cobertura total del país al momento de llevar adelante los distintos operativos censales (INDEC, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12"/>
        <codigo>1202</codigo>
        <rdfs:label xml:lang="es">Áreas Urbanas Censales</rdfs:label>
        <skos:definition xml:lang="es">Comprende aquellas porciones del territorio donde se asienta la población y que presenta características distintivas y particulares que permiten diferenciarlas de aquellas zonas no urbanas (INDEC, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/2301 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/2301">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/23"/>
        <codigo>2301</codigo>
        <rdfs:label xml:lang="es">Entidad De Información</rdfs:label>
        <skos:definition xml:lang="es">Entidades que se utilizan para modelar la información relativa a los tipos de fenómenos, pero que no representan fenómenos en sí mismos. Por ejemplo, las características del pavimento compartidas por muchos tipos de rutas de transporte terrestre, o las características de calidad de los datos compartidas por todas las masas de agua continentales. (Adaptación del DFDD) - IDESoB 2024</skos:definition>
    </owl:NamedIndividual>
    


