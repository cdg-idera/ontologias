        <codigo>010304</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Área de riesgo agropecuario</rdfs:label>
        <skos:definition xml:lang="es">Área caracterizada por la combinación de la probabilidad de que se produzca un evento y sus consecuencias negativas sobre la actividad agropecuaria. Principalmente son los riesgos derivados del impacto del clima.</skos:definition>
    </owl:NamedIndividual>
    


