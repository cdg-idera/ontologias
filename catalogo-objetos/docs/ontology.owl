        <codigoValorDominio>102</codigoValorDominio>
        <observacionFuente xml:lang="es">Instrumento que realiza mediciones meteorológicas de rutina en la atmósfera, normalmente la presión del aire, la temperatura y la humedad.</observacionFuente>
        <rdfs:label xml:lang="es">Estacion meteorologica</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/114 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/114">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
