    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010201">
        <rdfs:label xml:lang="es">Fábrica</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010202">
        <rdfs:label xml:lang="es">Planta de tratamiento de efluentes cloacales</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010203">
        <rdfs:label xml:lang="es">Astillero</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010204">
        <rdfs:label xml:lang="es">Planta potabilizadora de agua</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010205">
        <rdfs:label xml:lang="es">Área de fabricación y procesamiento</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010206">
        <rdfs:label xml:lang="es">Pileta de tratamiento</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010207">
        <rdfs:label xml:lang="es">Acueducto</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010301">
        <rdfs:label xml:lang="es">Área de actividad agrícola</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010302">
        <rdfs:label xml:lang="es">Área de actividad  pecuaria</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010303">
        <rdfs:label xml:lang="es">Rodal forestal</rdfs:label>
