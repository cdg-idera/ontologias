    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CBI/08AH -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CBI/08AH">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CBI"/>
        <codigoValorDominio>08AH</codigoValorDominio>
        <observacionFuente xml:lang="es">Buque de investigación, Motovelero oceanografico. Construido entre 1929 and 1930 en Dinamarca como el Atlantis. Sirvio como el primero y el principal buque de investigación de la Woods Hole Oceanographic Institution emtre 1931-1964. Vendido a la Argentina y renombrado como El Austral in 1966. Fue completamente reconstruido y rediseñado.  Señal distintiva: L2EF, eslora: 47, MMSI: 701006249.</observacionFuente>
        <rdfs:label xml:lang="es">Dr. Bernardo Houssay</rdfs:label>
    </owl:NamedIndividual>
    


