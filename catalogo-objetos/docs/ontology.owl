        <rdfs:label xml:lang="es">Lado catastral</rdfs:label>
        <skos:definition xml:lang="es">Valor numérico del lado de un polígono (referido a un objeto catastral) que representa su longitud (ARBA, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110107 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110107">
