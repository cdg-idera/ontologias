        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0202</codigo>
        <rdfs:label xml:lang="es">Equipamiento</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que están en relación con la prestación de servicios a la comunidad (IDERA, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0203 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0203">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0203</codigo>
        <rdfs:label xml:lang="es">Comercio Y Turismo</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se refieren a actividades comerciales, a complejos con fines comerciales, turísticos y/o de negocios. En el caso del turismo, las actividades se realizan por un período determinado de tiempo, en un lugar distinto al del entorno habitual, y donde se desarrolla una actividad no remunerada (IDERA 2015 - INFUETUR 2024)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0204 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0204">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0204</codigo>
        <rdfs:label xml:lang="es">Recreación</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con las actividades recreativas y de ocio de las personas (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0205 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0205">
