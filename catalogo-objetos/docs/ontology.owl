        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0206</codigo>
        <rdfs:label xml:lang="es">Educación</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relativos a los establecimientos vinculados al desarrollo de actividades educativas (IDERA, 2015)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0207 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0207">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02"/>
        <codigo>0207</codigo>
        <rdfs:label xml:lang="es">Cultura</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan con las distintas expresiones culturales, credos y manifestaciones religiosas (IGN, 2015).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0208 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0208">
