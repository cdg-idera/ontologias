        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/DRE"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/JUR"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>041113</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Cuenca hidrográfica</rdfs:label>
        <skos:definition xml:lang="es">Territorio drenado por un único sistema de drenaje natural, es decir, que a través de un curso hídrico, sus aguas pueden dar a un cuerpo de agua, infiltrarse o evaporarse.​ Una cuenca hidrográfica es delimitada por la línea de las cumbres, también llamada divisoria de aguas.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041115 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041115">
