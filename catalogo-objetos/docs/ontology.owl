        <codigo>0302</codigo>
        <rdfs:label xml:lang="es">Vial</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se relacionan a las vías de comunicación para vehículos y personas. Se han incluido los fenómenos vías, carretera, carretera, camino, calles y carril bicicleta entre otros.  (Transporte, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0303 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0303">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0303</codigo>
        <rdfs:label xml:lang="es">Transporte Por Guía</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos relacionados a un transporte guiado por cable  (adaptación DFDD).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0304 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0304">
