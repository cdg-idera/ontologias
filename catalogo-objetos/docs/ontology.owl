        <esSubclaseDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03"/>
        <codigo>0301</codigo>
        <rdfs:label xml:lang="es">Ferroviario</rdfs:label>
        <skos:definition xml:lang="es">Objetos geográficos que se refieren al transporte sobre rieles  (Transporte, 2018).</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0302 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0302">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/SubclaseCatalogo"/>
