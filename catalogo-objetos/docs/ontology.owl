        <codigoValorDominio>39</codigoValorDominio>
        <observacionFuente xml:lang="es">Embarcación que está principalmente equipada, tripulada y operada con fines militares. Incluye buques de guerra de superficie de todos los tamaños y buques de apoyo logístico.</observacionFuente>
        <rdfs:label xml:lang="es">Embarcaciones de la Armada</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TPE/68 -->


