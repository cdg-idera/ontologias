    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/APC -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/APC">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/AtributoCatalogado"/>
        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/APC"/>
        <codigo>APC</codigo>
        <tieneDominio>NO</tieneDominio>
