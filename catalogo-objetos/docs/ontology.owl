        <codigo>051302</codigo>
        <dbyf>SI</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Reserva de Biosfera</rdfs:label>
        <skos:definition xml:lang="es">Ecosistema terrestre o costero/ marino, o una combinación de los mismos, reconocido como tal en un plano internacional en el marco del Programa MAB (Hombre y la Atmósfera) de la UNESCO.</skos:definition>
    </owl:NamedIndividual>
    


