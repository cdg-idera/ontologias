        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IDA"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">La relación entre la precipitación anual y la evapotranspiración de referencia anual es menor a 0,05.</observacionFuente>
        <rdfs:label xml:lang="es">Árido</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IDA"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">La relación entre la precipitación anual y la evapotranspiración de referencia anual se encuentra comprendida entre 0,05 y 0,20.</observacionFuente>
        <rdfs:label xml:lang="es">Hiperárido</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IDA"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">La relación entre la precipitación anual y la evapotranspiración de referencia anual se encuentra comprendida entre 0,20 y 0,50.</observacionFuente>
        <rdfs:label xml:lang="es">Semiárido</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IDA"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">La relación entre la precipitación anual y la evapotranspiración de referencia anual se encuentra comprendida entre 0,50 y 0,65.</observacionFuente>
        <rdfs:label xml:lang="es">Subhúmedo seco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IDA"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">La relación entre la precipitación anual y la evapotranspiración de referencia anual se encuentra comprendida entre 0,65 y 1,00.</observacionFuente>
        <rdfs:label xml:lang="es">Subhúmedo húmedo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IDA/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IDA"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">La relación entre la precipitación anual y la evapotranspiración de referencia anual es superior a 1,00.</observacionFuente>
        <rdfs:label xml:lang="es">Húmedo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Suelos muy aptos para cualquier tipo de agricultura, con mínima o ninguna limitación. Buena capacidad de retención de agua y alto contenido de materia orgánica.</observacionFuente>
        <rdfs:label xml:lang="es">Clase I</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Tierras con limitaciones moderadas (erosión, drenaje, salinidad), que permiten cultivos con prácticas de manejo específicas.</observacionFuente>
        <rdfs:label xml:lang="es">Clase II</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Limitaciones moderadas a severas, que restringen la elección de cultivos y exigen prácticas de conservación más intensas.</observacionFuente>
        <rdfs:label xml:lang="es">Clase III</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Limitaciones severas, aptas solo para pastoreo, forestación o algunos cultivos específicos con alto manejo.</observacionFuente>
        <rdfs:label xml:lang="es">Clase IV</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Suelos con limitaciones muy severas; el uso es apto solo para pastoreo, forestación y no son aptos para agricultura.</observacionFuente>
        <rdfs:label xml:lang="es">Clase V</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">Limitaciones muy severas, aptas principalmente para pastoreo y forestación. La pedregosidad o la susceptibilidad a inundaciones son comunes.</observacionFuente>
        <rdfs:label xml:lang="es">Clase VI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">Limitaciones extremas, uso restringido a pastoreo y conservación, no para agricultura. Pueden tener pendientes pronunciadas o ser pedregosos.</observacionFuente>
        <rdfs:label xml:lang="es">Clase VII</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/8 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IED/8">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IED"/>
        <codigoValorDominio>8</codigoValorDominio>
        <observacionFuente xml:lang="es">Suelos no aptos para fines agrícolas o ganaderos, como desiertos. Su uso se limita a la conservación o actividades recreativas.</observacionFuente>
        <rdfs:label xml:lang="es">Clase VIII</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Muy débil. Imperceptible para la mayoría excepto en condiciones favorables. Aceleración menor a 0,5 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">I</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/10 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/10">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>10</codigoValorDominio>
        <observacionFuente xml:lang="es">Desastroso. Algunas estructuras de madera bien construidas quedan destruidas. La mayoría de las estructuras de mampostería y el marco destruido con sus bases. Vías ferroviarias dobladas. Aceleración entre 250 y 500 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">X</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/11 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/11">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>11</codigoValorDominio>
        <observacionFuente xml:lang="es">Muy desastroso. Pocas estructuras de mampostería, si las hubiera, permanecen en pie. Puentes destruidos. Vías ferroviarias curvadas en gran medida. Aceleración mayor a 500 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">XI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/12 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/12">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>12</codigoValorDominio>
        <observacionFuente xml:lang="es">Catastrófico. Destrucción total con pocos supervivientes. Los objetos saltan al aire. Los niveles y perspectivas quedan distorsionados. Imposibilidad de mantenerse en pie.</observacionFuente>
        <rdfs:label xml:lang="es">XII</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Débil. Perceptible sólo por algunas personas en reposo, particularmente aquellas que se encuentran ubicadas en los pisos superiores de los edificios. Los objetos colgantes suelen oscilar. Aceleración entre 0,5 y 2,5 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">II</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Leve. Perceptible por algunas personas dentro de los edificios, especialmente en pisos altos. Muchos no lo perciben como un terremoto. Los automóviles detenidos se mueven ligeramente. Sensación semejante al paso de un camión pequeño. Aceleración entre 2,5 y 6,0 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">III</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Moderado. Perceptible por la mayoría de personas dentro de los edificios, por pocas personas en el exterior durante el día. Durante la noche algunas personas pueden despertarse. Perturbación en cerámica, puertas y ventanas. Las paredes suelen hacer ruido. Los automóviles detenidos se mueven con más energía. Sensación semejante al paso de un camión grande. Aceleración entre 6,0 y 10 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">IV</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Poco fuerte. Sacudida sentida casi por todo el país o zona y algunas piezas de vajilla o cristales de ventanas se rompen; pocos casos de agrietamiento de aplanados; caen objetos inestables. Se observan perturbaciones en los árboles, postes y otros objetos altos. Se detienen los relojes de péndulo. Aceleración entre 10 y 20 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">V</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">Fuerte. Sacudida sentida por todo el país o zona. Algunos muebles pesados cambian de sitio y provoca daños leves, en especial en viviendas de material ligero. Aceleración entre 20 y 35 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">VI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">Muy fuerte. Ponerse de pie es difícil. Muebles dañados. Daños insignificantes en estructuras de buen diseño y construcción. Daños leves a moderados en estructuras ordinarias bien construidas. Daños considerables en estructuras pobremente construidas. Mampostería dañada. Perceptible por personas en vehículos en movimiento. Aceleración entre 35 y 60 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">VII</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/8 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/8">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>8</codigoValorDominio>
        <observacionFuente xml:lang="es">Destructivo. Daños leves en estructuras especializadas. Daños considerables en estructuras ordinarias bien construidas, posibles derrumbes. Daño severo en estructuras pobremente construidas. Mampostería seriamente dañada o destruida. Muebles completamente sacados de lugar. Aceleración entre 60 y 100 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">VIII</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/9 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IEM/9">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IEM"/>
        <codigoValorDominio>9</codigoValorDominio>
        <observacionFuente xml:lang="es">Muy destructivo. Pánico generalizado. Daños considerables en estructuras especializadas, paredes fuera de plomo. Grandes daños en importantes edificios, con derrumbes parciales. Edificios desplazados fuera de las bases. Aceleración entre 100 y 250 Gal.</observacionFuente>
        <rdfs:label xml:lang="es">IX</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas se encuentra entre 0 a 1.</observacionFuente>
        <rdfs:label xml:lang="es">0 a 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas se encuentra entre 2 a 3.</observacionFuente>
        <rdfs:label xml:lang="es">2 a 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas se encuentra entre 4 a 5.</observacionFuente>
        <rdfs:label xml:lang="es">4 a 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas se encuentra entre 6 a 10.</observacionFuente>
        <rdfs:label xml:lang="es">6 a 10</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas se encuentra entre 11 a 20.</observacionFuente>
        <rdfs:label xml:lang="es">11 a 20</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas se encuentra entre 21 a 30.</observacionFuente>
        <rdfs:label xml:lang="es">21 a 30</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/IFN/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/IFN"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">La frecuencia anual media de nevadas es superior a 30.</observacionFuente>
        <rdfs:label xml:lang="es">más de 30</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/10 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/10">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>10</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la elaboración de los productos de la agricultura, la ganadería, la silvicultura y la pesca para convertirlos en alimentos y bebidas para consumo humano o animal, e incluye la producción de varios productos intermedios que no son directamente productos alimenticios. Se organiza por actividades que se realizan con los distintos tipos de productos: carne, pescado, fruta, legumbres y hortalizas, grasas y aceites, productos lácteos, productos de molinería, alimentos preparados para animales y otros productos alimenticios y bebidas.</observacionFuente>
        <rdfs:label xml:lang="es">Elaboración de productos alimenticios</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/100 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/100">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>100</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de ladrillos y productos conexos, incluyendo las ladrilleras.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de ladrillos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/11 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/11">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>11</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la elaboración de bebidas no alcohólicas y agua mineral, la elaboración de bebidas alcohólicas obtenidas principalmente por fermentación, como cerveza y vino, y la elaboración de bebidas alcohólicas destiladas. No se incluyen la producción de jugos de frutas y de hortalizas, la elaboración de bebidas a base de leche, ni la elaboración de productos de café, té y mate.</observacionFuente>
        <rdfs:label xml:lang="es">Elaboración de bebidas</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/12 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/12">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>12</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la elaboración de un producto agrícola, el tabaco, en forma adecuada para su consumo final.</observacionFuente>
        <rdfs:label xml:lang="es">Elaboración de productos de tabaco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/13 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/13">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>13</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la preparación e hilatura de fibras textiles y la tejedura y el acabado de productos textiles y prendas de vestir, así como la fabricación de artículos confeccionados de materiales textiles, excepto prendas de vestir.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de productos textiles</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/14 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/14">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>14</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende todas las actividades de confección, en todo tipo de materiales (cuero, tela, tejidos de punto y ganchillo, etc.), de todo tipo de prendas de vestir y accesorios.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de prendas de vestir</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/15 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/15">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>15</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende el adobo y teñido de pieles, la transformación de pieles en cuero mediante operaciones de curtido y adobo y la fabricación de productos acabados de cuero. Abarca también la fabricación de productos similares a partir de otros materiales (cueros de imitación o sucedáneos de cuero), como calzado de caucho, maletas de materiales textiles, y otros.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de productos de cuero y productos conexos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/16 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/16">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>16</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de productos de madera, como maderos, tableros contrachapados, hojas de madera para enchapado, contenedores de madera, pisos de madera, armazones de madera y edificios prefabricados de madera. Los procesos de producción comprenden el aserrado, la acepilladura, el recorte, el laminado y el ensamblaje de productos de madera a partir de troncos que se cortan en trozos o maderos que se pueden volver a cortar o a los que se puede dar forma con tornos u otras herramientas.</observacionFuente>
        <rdfs:label xml:lang="es">Producción de madera y fabricación de productos de madera y corcho, excepto muebles</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/17 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/17">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>17</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de pasta de madera, papel y productos de papel. La fabricación de esos productos está agrupada porque abarca una serie de procesos conectados verticalmente. Es frecuente que una misma unidad realice más de una de esas actividades. Se trata esencialmente de tres actividades: la fabricación de pasta de madera entraña la separación de las fibras de celulosa de otras impurezas de la madera o el papel usado; la fabricación de papel consiste en el afeltrado de esas fibras hasta convertirlas en una lámina.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de papel y de productos de papel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/18 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/18">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>18</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la impresión de productos, como periódicos, libros, revistas, formularios comerciales, tarjetas de felicitación y otros materiales, y actividades de apoyo conexas, como encuadernación, servicios de preparación de placas y formación de imágenes a partir de datos.</observacionFuente>
        <rdfs:label xml:lang="es">Impresión y reproducción de grabaciones</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/19 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/19">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>19</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la transformación del petróleo crudo y el carbón en productos utilizables. El proceso principal es la refinación del petróleo, que entraña la separación del petróleo crudo en los distintos productos. Comprende la fabricación de gases, como etano, propano y butano, como productos de las refinerías de petróleo.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de coque y productos de la refinación del petróleo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/20 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/20">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>20</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la transformación de materias primas orgánicas e inorgánicas mediante un proceso químico y la formación de productos.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de sustancias y productos químicos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/21 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/21">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>21</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de productos farmacéuticos básicos y preparados farmacéuticos. Se incluye también la fabricación de sustancias químicas medicinales y productos botánicos.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de productos farmacéuticos, sustancias químicas medicinales y productos botánicos.</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/22 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/22">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>22</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de productos de caucho y de plástico. La división se define por las materias primas utilizadas en el proceso de fabricación, lo que no significa que se clasifique en ella la fabricación de todos los productos hechos con esos materiales.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de productos de caucho y de plástico</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/23 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/23">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>23</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de vidrio y productos de vidrio, productos de cerámica, losetas y productos de arcilla cocida, y cemento y yeso desde las materias primas hasta los artículos acabados. Se incluyen también el corte, la talla y el acabado de la piedra, secaderos de sal, y otros productos minerales.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de otros productos minerales no metálicos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/24 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/24">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>24</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende las actividades de fundición y/o refinación de metales ferrosos y no ferrosos a partir de mineral y escorias de hierro, por medio de técnicas electrometalúrgicas y de otras técnicas metalúrgicas. Abarca también la fabricación de aleaciones y superaleaciones de metales mediante la introducción de otros elementos químicos en los metales puros.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de metales comunes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/25 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/25">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>25</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de productos de metal “puro” (como partes, recipientes y estructuras) que normalmente tienen una función estática, inamovible. También se incluye la fabricación de armas y municiones.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de productos elaborados de metal, excepto maquinaria y equipo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/26 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/26">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>26</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de ordenadores, equipo periférico, equipo de comunicaciones y productos electrónicos similares, así como la fabricación de componentes para esos productos. También se incluye la fabricación de aparatos electrónicos de consumo, equipo de medición, prueba, navegación y control, equipo de irradiación, equipo electrónico de uso médico y terapéutico, instrumentos y equipo ópticos y soportes magnéticos y ópticos.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de productos de informática, de electrónica y de óptica</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/27 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/27">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>27</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de productos que se utilizan para generar, distribuir y utilizar energía eléctrica. También se incluye la fabricación de lámparas eléctricas, equipo de señales y aparatos eléctricos de uso doméstico. No se incluye la fabricación de productos electrónicos.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de equipo eléctrico</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/28 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/28">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>28</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de maquinaria y equipo que actúan de manera independiente sobre los materiales ya sea mecánica o térmicamente, o que realizan operaciones sobre los materiales (como el manejo, el rociado, el pesado o el embalado), incluidos sus componentes mecánicos que producen y aplican fuerza, y cualquier parte primaria fabricada especialmente. Se incluye la fabricación de aparatos fijos y móviles o manuales, destinados a ser utilizados en actividades industriales, de construcción y de ingeniería civil, en la agricultura o en el hogar. Se incluye también la fabricación de equipo especial para el trasporte de pasajeros o de carga en zonas delimitadas. Se incluye también la fabricación de otros tipos de maquinaria de uso especial no clasificados en otra parte, se utilicen o no en un proceso de manufactura, como equipo para atracciones de feria, equipo automático para boleras, y otros.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de maquinaria y equipo n.c.p.</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/29 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/29">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>29</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de vehículos automotores para el transporte de pasajeros o de carga. Se incluye la fabricación de diversas partes, piezas y accesorios, así como la fabricación de remolques y semirremolques.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de vehículos automotores, remolques y semirremolques</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/30 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/30">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>30</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de equipo de transporte, como la construcción de buques y otras embarcaciones, la fabricación de locomotoras y material rodante, aeronaves y naves espaciales y la fabricación de partes y piezas de los mismos.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de otro equipo de transporte</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/31 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/31">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>31</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de muebles y productos conexos de cualquier material, excepto piedra, hormigón y cerámica. Los procesos utilizados en la fabricación de muebles son métodos estandarizados para conformar materiales y ensamblar componentes, como el corte, el moldeo y la laminación.</observacionFuente>
        <rdfs:label xml:lang="es">Fabricación de muebles</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/32 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/32">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>32</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende la fabricación de diversos productos no clasificados en otra parte. Puesto que se trata de una división residual, los procesos de producción, los materiales utilizados como insumos y la utilización de los productos resultantes pueden variar considerablemente, y no se han aplicado los criterios habitualmente empleados para agrupar las clases en divisiones.</observacionFuente>
        <rdfs:label xml:lang="es">Otras industrias manufactureras</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/33 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/ISIC/33">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/ISIC"/>
        <codigoValorDominio>33</codigoValorDominio>
        <observacionFuente xml:lang="es">Comprende las actividades de reparación de productos para volver a poner en funcionamiento maquinaria, equipo y otros productos. Se incluyen las actividades de mantenimiento (servicio) general u ordinario de esos productos para garantizar que funcionen eficientemente y prevenir averías y reparaciones innecesarias.</observacionFuente>
        <rdfs:label xml:lang="es">Reparación e instalación de maquinaria y equipo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/LOC"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/40 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/40">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/LOC"/>
        <codigoValorDominio>40</codigoValorDominio>
        <observacionFuente xml:lang="es">Enterrado bajo el terreno.</observacionFuente>
        <rdfs:label xml:lang="es">Bajo la superficie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/44 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/44">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/LOC"/>
        <codigoValorDominio>44</codigoValorDominio>
        <observacionFuente xml:lang="es">Localizado a nivel del terreno.</observacionFuente>
        <rdfs:label xml:lang="es">En la superficie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/45 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/45">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/LOC"/>
        <codigoValorDominio>45</codigoValorDominio>
        <observacionFuente xml:lang="es">Localizado por encima de la superficie del terreno.</observacionFuente>
        <rdfs:label xml:lang="es">Sobre la superficie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/48 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/48">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/LOC"/>
        <codigoValorDominio>48</codigoValorDominio>
        <observacionFuente xml:lang="es">Depresión del terreno natural o como resultado de efectuar un corte en el mismo para el asentamiento de una vía de comunicación, quedando esta situada entre dos paredes (taludes) para permitir la circulación a una altura inferior al perfil orográfico.</observacionFuente>
        <rdfs:label xml:lang="es">En trinchera</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/49 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/LOC/49">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/LOC"/>
        <codigoValorDominio>49</codigoValorDominio>
        <observacionFuente xml:lang="es">Macizo de tierra que se eleva artificialmente para hacer una defensa, vía de comunicación u otra obra semejante.</observacionFuente>
        <rdfs:label xml:lang="es">En terraplén</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/MCC/-1">
