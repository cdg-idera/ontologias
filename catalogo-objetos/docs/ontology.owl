        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando el radio está conformado por viviendas diseminadas en campo abierto, con población dispersa únicamente.</observacionFuente>
        <rdfs:label xml:lang="es">Rural</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TRO/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TRO/3">
