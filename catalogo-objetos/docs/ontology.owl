        <rdfs:label xml:lang="es">Código de asentamiento</rdfs:label>
        <skos:definition xml:lang="es">Código oficial de asentamiento humano correspondiente a la Base de Asentamientos Humanos de la República Argentina (BAHRA).</skos:definition>
