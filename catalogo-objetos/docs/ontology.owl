        <codigoValorDominio>134</codigoValorDominio>
        <observacionFuente xml:lang="es">Instrumento que mide la temperatura del agua con la que está en contacto.</observacionFuente>
        <rdfs:label xml:lang="es">Sensor de temperatura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/156 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/156">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDM"/>
        <codigoValorDominio>156</codigoValorDominio>
