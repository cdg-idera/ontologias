        <defineClaseImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/030809"/>
        <perteneceASubclase rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0308"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA"/>
        <tieneAtributo rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG"/>
        <codigo>030809</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Centro de transbordo</rdfs:label>
        <skos:definition xml:lang="es">Nodo central del sistema de transporte que permite la articulación entre redes de los distintos modos o entre líneas de un mismo modo de transporte, organizando el transporte. También se lo denomina estación intermodal.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030810 -->


