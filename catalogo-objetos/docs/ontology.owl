        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SNL"/>
        <codigoValorDominio>1</codigoValorDominio>
        <rdfs:label xml:lang="es">1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SWT"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SWT"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Fuente natural de agua caliente.</observacionFuente>
        <rdfs:label xml:lang="es">Fuente termal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SWT"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Vertiente de agua natural que emana de la roca o del suelo.</observacionFuente>
        <rdfs:label xml:lang="es">Manantial</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SWT"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Pequeña depresión de tierra en la que el agua se acumula.</observacionFuente>
        <rdfs:label xml:lang="es">Ojo de agua</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/SWT/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SWT"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">Fuente mineral de agua.</observacionFuente>
        <rdfs:label xml:lang="es">Fuente mineral</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuerpo de agua salada de menor extensión que los océanos, cercado de continentes y generalmente conectado con un océano o con un mar mayor.</observacionFuente>
        <rdfs:label xml:lang="es">Mar</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/10 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/10">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>10</codigoValorDominio>
        <observacionFuente xml:lang="es">Estrecha lengua de tierra que une dos continentes o una península con un continente.</observacionFuente>
        <rdfs:label xml:lang="es">Istmo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/11 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/11">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>11</codigoValorDominio>
        <observacionFuente xml:lang="es">Superficie de tierra de baja altura que penetra en el mar, corriente de agua o espejo de agua. Ejemplo: Punta Dungeness, Provincia de Santa Cruz.</observacionFuente>
        <rdfs:label xml:lang="es">Punta</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/12 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/12">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>12</codigoValorDominio>
        <observacionFuente xml:lang="es">Superficie de tierra de relieve accidentado que sobresale de la línea de costa y penetra en el mar.</observacionFuente>
        <rdfs:label xml:lang="es">Cabo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/13 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/13">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>13</codigoValorDominio>
        <observacionFuente xml:lang="es">Porción de mar relativamente larga y estrecha que conecta dos cuerpos de agua (mares, océanos o lagos), y por tanto, se encuentra entre dos masas de tierra. Ejemplo: Estrecho de Magallanes.</observacionFuente>
        <rdfs:label xml:lang="es">Estrecho</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/14 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/14">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>14</codigoValorDominio>
        <observacionFuente xml:lang="es">Zona de la costa que ofrece resguardo natural a las embarcaciones.</observacionFuente>
        <rdfs:label xml:lang="es">Puerto natural</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Sector estrecho de mar que separa dos porciones del mismo continente. Ejemplo: Canal de Beagle.</observacionFuente>
        <rdfs:label xml:lang="es">Canal marítimo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Conjunto de islas de diversos tamaños, en el mar, corriente de agua o espejo de agua, no muy distantes unas de otras.</observacionFuente>
        <rdfs:label xml:lang="es">Archipiélago</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Desembocadura de una corriente de agua en un espejo de agua, mar, estuario, que frena su velocidad, perdiendo poder de carga y haciendo que deposite sus sedimentos. Tiene forma de delta griega.</observacionFuente>
        <rdfs:label xml:lang="es">Delta</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Desembocadura ancha de una corriente de agua, donde accionan las mareas y se mezclan las aguas en marea alta.</observacionFuente>
        <rdfs:label xml:lang="es">Estuario</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">Valle de origen fluvial inundado por el mar. Ejemplo: Ría del Río Deseado.</observacionFuente>
        <rdfs:label xml:lang="es">Ría</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">Accidente marítimo de extensión variable y mayor rango dimensional que una bahía. Es una parte del mar que se interna en el continente, entre dos prominencias costeras.</observacionFuente>
        <rdfs:label xml:lang="es">Golfo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/8 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/8">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>8</codigoValorDominio>
        <observacionFuente xml:lang="es">Penetración profunda del mar en la costa, de entrada ancha y donde accionan las mareas.</observacionFuente>
        <rdfs:label xml:lang="es">Bahía</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/9 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TA1/9">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TA1"/>
        <codigoValorDominio>9</codigoValorDominio>
        <observacionFuente xml:lang="es">Superficie de tierra que en su mayor parte se encuentra rodeada de agua, y que se une a una extensión de tierra mayor a través de un istmo. Se forma por erosión. Ejemplo: Península de Valdés (Provincia del Chubut), Península de San Pedro, Lago Nahuel Huapi (Provincia de Río Negro).</observacionFuente>
        <rdfs:label xml:lang="es">Península</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/-1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/-1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>-1</codigoValorDominio>
        <observacionFuente xml:lang="es">Cuando no se dispone o no se tiene certeza de los datos.</observacionFuente>
        <rdfs:label xml:lang="es">Información no disponible</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Es un área que está protegida de todo uso humano excepto el ligero, con el fin de preservar las características geológicas y geomorfológicas de la región y su biodiversidad. Estas áreas están restringidas a toda perturbación humana fuera de los estudios científicos, el monitoreo ambiental y la educación, por ello proveen ambientes prístinos ideales para medir la influencia humana externa. En algunos casos las reservas naturales estrictas tienen un significado espiritual para las comunidades circundantes, y las áreas también están protegidas por esta razón. La gente que practica su fe en la región tiene derecho a seguir haciéndolo, siempre que esté en consonancia con los objetivos de conservación y gestión del área</observacionFuente>
        <rdfs:label xml:lang="es">Categoria Ia: Reserva natural estricta</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Similar a una reserva natural estricta, pero generalmente más grande y protegida de forma ligeramente menos estricta</observacionFuente>
        <rdfs:label xml:lang="es">Categoría Ib: Área silvestre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/3 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/3">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Un parque nacional o provincial es similar a un área silvestre en su tamaño y en su objetivo principal de proteger los ecosistemas que funcionan. Los parques se gestionan de forma que pueden contribuir a las economías locales mediante la promoción del turismo educativo y recreativo a una escala que no reducirá la eficacia de los esfuerzos de conservación. Las áreas circundantes de un parque pueden ser de &quot;uso consuntivo o no consuntivo&quot;, pero deben actuar como una barrera para la defensa de las especies y comunidades nativas del área protegida para que puedan sostenerse a largo plazo.</observacionFuente>
        <rdfs:label xml:lang="es">Categoría II: Parque nacional</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Un monumento o característica natural es un área comparativamente más pequeña que se asigna específicamente para proteger un monumento natural y sus hábitats circundantes. Estos monumentos pueden ser naturales en su sentido más amplio o incluir elementos que han sido influenciados o introducidos por el hombre. Estos últimos deberían contener asociaciones de biodiversidad o podrían clasificarse de otra manera como un sitio histórico o espiritual, aunque esta distinción puede ser bastante difícil de determinar.</observacionFuente>
        <rdfs:label xml:lang="es">Categoria III: Monumento o característica natural</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/5 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/5">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>5</codigoValorDominio>
        <observacionFuente xml:lang="es">Un hábitat o área de gestión de especies es similar a un monumento natural, pero se centra en áreas de conservación más específicas, como una especie o hábitat identificable que requiere protección continua en lugar de la de una característica natural. Estas áreas protegidas estarán suficientemente controladas para asegurar el mantenimiento, la conservación y la restauración de especies y hábitats particulares y se fomenta ampliamente la educación pública de dichas áreas como parte de los objetivos de gestión. Las áreas de gestión de hábitats o de especies pueden existir como una fracción de un ecosistema o área protegida más amplia y pueden requerir diversos niveles de protección activa como la prevención de la caza furtiva, la creación de hábitats artificiales y la detención de la sucesión natural.</observacionFuente>
        <rdfs:label xml:lang="es">Categoria IV: Área de Manejo de Hábitat / Especies</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/6 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/6">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>6</codigoValorDominio>
        <observacionFuente xml:lang="es">Un paisaje terrestre o marino protegido cubre un conjunto entero de tierra o de océano con un plan de conservación natural explícito, pero normalmente también da cabida a una serie de actividades con ánimo de lucro</observacionFuente>
        <rdfs:label xml:lang="es">Categoría V: Paisaje protegido/ Marino/Área</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/7 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TAP/7">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TAP"/>
        <codigoValorDominio>7</codigoValorDominio>
        <observacionFuente xml:lang="es">La participación humana es un factor importante en la gestión de esta categoría y puede permitirse una producción industrial a gran escala. La UICN recomienda que una proporción de la masa terrestre permanezca en su condición natural —una decisión que debe tomarse a nivel nacional, normalmente con una especificidad para cada área protegida. Se debe desarrollar la gobernanza para adaptar la diversa y creciente gama de intereses que surgen de la producción de recursos naturales sostenibles. Es adecuada para vastas áreas que ya tienen un bajo nivel de ocupación humana o en las que las comunidades locales y sus prácticas tradicionales han tenido poco impacto permanente en la salud ambiental de la región y difiere de la categoría V en que no es el resultado de una interacción humana a largo plazo que haya tenido un efecto transformador en los ecosistemas circundantes</observacionFuente>
        <rdfs:label xml:lang="es">Categoría VI: Área protegida con uso sostenible de los recursos naturales</rdfs:label>
    </owl:NamedIndividual>
    


