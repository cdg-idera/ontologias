        <skos:definition xml:lang="es">Parte de la superficie terrestre rodeada de agua y de dimensiones menores que un continente.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/040301 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/040301">
