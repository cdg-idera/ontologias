        <rdfs:label xml:lang="es">Puesto de boleto electrónico</rdfs:label>
        <skos:definition xml:lang="es">Punto de venta y / o recarga de dispositivos de los sistemas de pago electrónico de boleto.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/040101 -->


