        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAM"/>
        <codigoValorDominio>3</codigoValorDominio>
        <observacionFuente xml:lang="es">Valor de dominio que denota un bajo valor de conservación que pueden transformarse parcialmente o en su totalidad aunque dentro de los criterios de la presente ley.</observacionFuente>
        <rdfs:label xml:lang="es">Categoría III (verde)</rdfs:label>
    </owl:NamedIndividual>
    


