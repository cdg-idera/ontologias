    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/41 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/41">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/TYP"/>
        <codigoValorDominio>41</codigoValorDominio>
        <observacionFuente xml:lang="es">Vía multicarril sin cruces a nivel con otra calle o ferrocarril, con puentes, con calzadas separadas físicamente y con limitación de ingreso directo desde los predios frentistas lindantes.</observacionFuente>
        <rdfs:label xml:lang="es">Autopista</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/47 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/TYP/47">
