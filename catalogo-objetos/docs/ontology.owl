        <skos:definition xml:lang="es">Lugar con instalaciones para controlar el paso, declarar y/o inspeccionar los bienes, vehículos y/o personas.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/030701 -->


