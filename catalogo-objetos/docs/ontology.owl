        <codigo>120204</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Linea</tipoGeometrico>
        <rdfs:label xml:lang="es">Vias de circulación censal</rdfs:label>
        <skos:definition xml:lang="es">Trazado que permite la circulación en el interior de una localidad censal y que no es parte del acceso a la misma. Determina los límites de manzanas censales. (INDEC 2025)</skos:definition>
    </owl:NamedIndividual>
    


