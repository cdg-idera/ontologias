    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/1 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/1">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>1</codigoValorDominio>
        <observacionFuente xml:lang="es">Se traza cada cierto número de curvas intermedias, dependiendo de la equidistancia.</observacionFuente>
        <rdfs:label xml:lang="es">Directriz</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/100 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/100">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>100</codigoValorDominio>
        <observacionFuente xml:lang="es">Curva de nivel utilizada en áreas cubiertas de nieve, donde no es posible trazar una curva directriz.</observacionFuente>
        <rdfs:label xml:lang="es">De nieve</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/101 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/101">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>101</codigoValorDominio>
        <observacionFuente xml:lang="es">Curva utilizada en áreas cubiertas de nieve donde no es posible trazar una curva figurativa que represente la configuración estimada de elevaciones entre curvas de nivel.</observacionFuente>
        <rdfs:label xml:lang="es">De nieve figurativa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/16 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/16">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>16</codigoValorDominio>
        <observacionFuente xml:lang="es">Curva de nivel que se utiliza para describir las características importantes, que no son mostradas por las curvas de nivel directrices e intermedias porque no es posible su trazado. Se diferencia de la figurativa en que con la auxiliar, a pesar de que es posible acotar correctamente, no da la equidistancia.</observacionFuente>
        <rdfs:label xml:lang="es">Auxiliar</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/2 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/2">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>2</codigoValorDominio>
        <observacionFuente xml:lang="es">Se encuentra contenida entre curvas directrices y depende de la equidistancia.</observacionFuente>
        <rdfs:label xml:lang="es">Intermedia</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/4 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/4">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>4</codigoValorDominio>
        <observacionFuente xml:lang="es">Curva que representa la configuración estimada de elevaciones entre curvas de nivel, y se utiliza cuando no se tiene la cota real del terreno.</observacionFuente>
        <rdfs:label xml:lang="es">Figurativa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/8 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HQC/8">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ValorDominio"/>
        <esValorDeDominioDe rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/HQC"/>
        <codigoValorDominio>8</codigoValorDominio>
        <observacionFuente xml:lang="es">Curva de nivel cerrada que delimita un área localizada de elevación más alta que el terreno circundante en el cual no hay ningún drenaje superficial.</observacionFuente>
        <rdfs:label xml:lang="es">Elevación importante</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/HYP/-1 -->


