        <definePropiedadImplementable rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/property/IPS"/>
        <codigo>IPS</codigo>
        <tieneDominio>NO</tieneDominio>
        <tipoAtributo xml:lang="es">Numérico</tipoAtributo>
        <rdfs:label xml:lang="es">Índice de Productividad de los Suelos</rdfs:label>
        <skos:definition xml:lang="es">Clasificación de los suelos según el nivel de productividad de las tierras, desagregados a nivel de unidad cartográfica.  Emplea una fórmula multiplicativa de los factores climáticos, de suelo y terreno que inciden en el crecimiento y rendimiento de los cultivos, pasturas y forestales más comunes de una región, bajo un determinado nivel de manejo.  Se clasifica de 100 a 1.</skos:definition>
    </owl:NamedIndividual>
    


