        <codigo>041115</codigo>
        <dbyf>NO</dbyf>
        <tipoGeometrico xml:lang="es">Polígono</tipoGeometrico>
        <rdfs:label xml:lang="es">Subcuenca hidrográfica</rdfs:label>
        <skos:definition xml:lang="es">Superficie de terreno cuya escorrentía superficial fluye en su totalidad a través de una serie de corrientes, ríos y, eventualmente, lagos, hacia un determinado punto de un curso de agua, generalmente un lago o una confluencia de ríos. (IDESoB 2024)</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041116 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041116">
        <rdf:type rdf:resource="https://cdg-idera.github.io/ontologias/catalogo-objetos/ObjetoGeograficoCatalogado"/>
