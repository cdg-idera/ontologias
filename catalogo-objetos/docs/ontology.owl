        <codigoValorDominio>115</codigoValorDominio>
        <observacionFuente xml:lang="es">Instrumento que mide la velocidad y la dirección de la corriente a múltiples profundidades predeterminadas simultáneamente (Ej. ADCP).</observacionFuente>
        <rdfs:label xml:lang="es">Perfilador de corriente</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/122 -->


    <owl:NamedIndividual rdf:about="https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/CDM/122">
