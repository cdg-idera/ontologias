@base <https://cdg-idera.github.io/ontologias/catalogo-objetos/> .
@prefix idera: <https://cdg-idera.github.io/ontologias/catalogo-objetos/> .
@prefix idera-clase: <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/> .
@prefix idera-subclase: <https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/> .
@prefix idera-og: <https://cdg-idera.github.io/ontologias/catalogo-objetos/og/> .
@prefix idera-feature: <https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/> .
@prefix idera-attr: <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/> .
@prefix idera-prop: <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/> .
@prefix idera-dom: <https://cdg-idera.github.io/ontologias/catalogo-objetos/dominio/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/>
    a owl:Ontology ;
    dcterms:title "Ontología del Catálogo de Objetos Geográficos de IDERA"@es ;
    dcterms:description "Esta ontología proporciona una representación semántica del Catálogo de Objetos Geográficos de IDERA V2.2. Modela su estructura de clases, subclases, objetos geográficos, atributos y dominios, preservando la semántica definida por el catálogo. Su propósito es facilitar la identificación, vinculación y validación semántica de información geoespacial conforme al Catálogo IDERA, favoreciendo la interoperabilidad y la reutilización de sus conceptos en diferentes sistemas y aplicaciones."@es ;
    dcterms:creator "Luis Reynoso" ;
    dcterms:publisher "Grupo de Trabajo Temático Ciencia de Datos Geoespaciales (GTT-CDG) de IDERA"@es ;
    dcterms:source <https://www.idera.gob.ar/index.php/recursos/catalogo-de-og-y-dbyf> ;
    dcterms:language "es" ;
    dcterms:issued "2026-09-15"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.2" ;
    owl:versionIRI <https://cdg-idera.github.io/ontologias/catalogo-objetos/version/2.2> .

idera:CatalogoObjetos
    a owl:Class ;
    rdfs:label "Catálogo de objetos geográficos"@es ;
    rdfs:comment "Recurso que representa el catálogo de objetos geográficos."@es .

idera:ClaseCatalogo
    a owl:Class ;
    rdfs:label "Clase del catálogo"@es ;
    rdfs:comment "Categoría organizativa de primer nivel del catálogo."@es .

idera:SubclaseCatalogo
    a owl:Class ;
    rdfs:label "Subclase del catálogo"@es ;
    rdfs:comment "Categoría organizativa de segundo nivel del catálogo."@es .

idera:ObjetoGeograficoCatalogado
    a owl:Class ;
    rdfs:label "Objeto Geográfico catalogado"@es ;
    rdfs:comment "Tipo de objeto geográfico definido en el catálogo; corresponde conceptualmente a FC_FeatureType de ISO 19110."@es .

idera:AtributoCatalogado
    a owl:Class ;
    rdfs:label "Atributo catalogado"@es ;
    rdfs:comment "Atributo definido en el catálogo; corresponde conceptualmente a FC_FeatureAttribute de ISO 19110."@es .

idera:ValorDominio
    a owl:Class ;
    rdfs:label "Valor de dominio"@es ;
    rdfs:comment "Valor listado de un atributo; corresponde conceptualmente a FC_ListedValue de ISO 19110."@es .

idera:tieneClase
    a owl:ObjectProperty ;
    owl:inverseOf idera:esClaseDe ;
    rdfs:label "tieneClase"@es .

idera:esClaseDe
    a owl:ObjectProperty ;
    owl:inverseOf idera:tieneClase ;
    rdfs:label "esClaseDe"@es .

idera:tieneSubclase
    a owl:ObjectProperty ;
    owl:inverseOf idera:esSubclaseDe ;
    rdfs:label "tieneSubclase"@es .

idera:esSubclaseDe
    a owl:ObjectProperty ;
    owl:inverseOf idera:tieneSubclase ;
    rdfs:label "esSubclaseDe"@es .

idera:tieneObjetoGeografico
    a owl:ObjectProperty ;
    owl:inverseOf idera:perteneceASubclase ;
    rdfs:label "tieneObjetoGeografico"@es .

idera:perteneceASubclase
    a owl:ObjectProperty ;
    owl:inverseOf idera:tieneObjetoGeografico ;
    rdfs:label "perteneceASubclase"@es .

idera:tieneAtributo
    a owl:ObjectProperty ;
    owl:inverseOf idera:esAtributoDe ;
    rdfs:label "tieneAtributo"@es .

idera:esAtributoDe
    a owl:ObjectProperty ;
    owl:inverseOf idera:tieneAtributo ;
    rdfs:label "esAtributoDe"@es .

idera:tieneValorDominio
    a owl:ObjectProperty ;
    owl:inverseOf idera:esValorDeDominioDe ;
    rdfs:label "tieneValorDominio"@es .

idera:esValorDeDominioDe
    a owl:ObjectProperty ;
    owl:inverseOf idera:tieneValorDominio ;
    rdfs:label "esValorDeDominioDe"@es .

idera:defineClaseImplementable
    a owl:ObjectProperty ;
    owl:inverseOf idera:implementaObjetoGeografico ;
    rdfs:label "defineClaseImplementable"@es .

idera:implementaObjetoGeografico
    a owl:ObjectProperty ;
    owl:inverseOf idera:defineClaseImplementable ;
    rdfs:label "implementaObjetoGeografico"@es .

idera:definePropiedadImplementable
    a owl:ObjectProperty ;
    owl:inverseOf idera:implementaAtributo ;
    rdfs:label "definePropiedadImplementable"@es .

idera:implementaAtributo
    a owl:ObjectProperty ;
    owl:inverseOf idera:definePropiedadImplementable ;
    rdfs:label "implementaAtributo"@es .

idera:correspondeAtributo
    a owl:ObjectProperty ;
    rdfs:label "corresponde a atributo IDERA"@es ;
    rdfs:comment "Relaciona una propiedad utilizada por una fuente de datos con el atributo semántico correspondiente del Catálogo IDERA."@es ;
    rdfs:range idera:AtributoCatalogado .

idera:codigo
    a owl:DatatypeProperty ;
    rdfs:label "código"@es .

idera:tipoGeometrico
    a owl:DatatypeProperty ;
    rdfs:label "tipo geométrico"@es .

idera:dbyf
    a owl:DatatypeProperty ;
    rdfs:label "DByF"@es .

idera:tipoAtributo
    a owl:DatatypeProperty ;
    rdfs:label "tipo de atributo"@es .

idera:tieneDominio
    a owl:DatatypeProperty ;
    rdfs:label "tiene dominio"@es .

idera:observacionFuente
    a owl:DatatypeProperty ;
    rdfs:label "observación de la fuente"@es .

idera:codigoValorDominio
    a owl:DatatypeProperty ;
    rdfs:label "código del valor de dominio"@es .

idera:catalogo-v2-2
    a idera:CatalogoObjetos ;
    rdfs:label "Catálogo de Objetos Geográficos de IDERA V2.2"@es .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01>
    a idera:ClaseCatalogo ;
    idera:codigo "01" ;
    rdfs:label "Industria Y Servicios"@es ;
    skos:definition "Comprende los objetos geográficos relacionados con la extracción y procesamiento de recursos naturales, producción agropecuaria, minería, industrialización, energía, comunicaciones, almacenamiento y logística, tratamiento y gestión de los residuos (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02>
    a idera:ClaseCatalogo ;
    idera:codigo "02" ;
    rdfs:label "Infraestructura Social"@es ;
    skos:definition "Comprende los objetos geográficos que se relacionan en el sentido más amplio con los aspectos sociales de la población. A esta clase pertenecen los dominios de la administración, el comercio, el turismo, el ocio, la educación, la cultura, la salud y la ciencia (IDERA, 2018 - INFUETUR 2024)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03>
    a idera:ClaseCatalogo ;
    idera:codigo "03" ;
    rdfs:label "Transporte"@es ;
    skos:definition "Comprende los objetos geográficos que se relacionan con el conjunto de instalaciones fijas, entidades de flujo y un sistema de control que permiten que personas y  bienes venzan la fricción del espacio geográfico 'eficientemente' a efectos de participar oportunamente en alguna actividad deseada (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04>
    a idera:ClaseCatalogo ;
    idera:codigo "04" ;
    rdfs:label "Hidrografía Y Oceanografía"@es ;
    skos:definition "Comprende los objetos geográficos naturales y artificiales relacionados a los ambientes marino, fluvial y lacustre. Incluye las características físicas y químicas del agua, la biología marina y la geología marina (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05>
    a idera:ClaseCatalogo ;
    idera:codigo "05" ;
    rdfs:label "Geografía Física"@es ;
    skos:definition "Comprende los objetos geográficos que se relacionan con las formas del relieve terrestre, los suelos y su cobertura (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06>
    a idera:ClaseCatalogo ;
    idera:codigo "06" ;
    rdfs:label "Biota"@es ;
    skos:definition "Comprende los objetos geográficos asociados a la distribución de los seres vivos (IGN, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07>
    a idera:ClaseCatalogo ;
    idera:codigo "07" ;
    rdfs:label "Demarcación"@es ;
    skos:definition "Comprende los objetos territoriales legales que se relacionan con las fronteras y los límites políticos, administrativos y de hecho (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/09>
    a idera:ClaseCatalogo ;
    idera:codigo "09" ;
    rdfs:label "Defensa Y Seguridad"@es ;
    skos:definition "Comprende los objetos geográficos inherentes a las instalaciones militares o a las estructuras de las operaciones militares (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10>
    a idera:ClaseCatalogo ;
    idera:codigo "10" ;
    rdfs:label "Clima Y Meteorología"@es ;
    skos:definition "Clasifica subcategorías que reúnen información climática y meteorológica (adaptación DFDD)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11>
    a idera:ClaseCatalogo ;
    idera:codigo "11" ;
    rdfs:label "Catastro"@es ;
    skos:definition "Comprende los objetos  territoriales legales que pertenecen a un determinado país o distrito, correspondientes a un inventario público, metódicamente ordenado, que contiene datos concernientes a los mismos y que se determinan a partir de actos de levantamientos territoriales. La unidad de registración del catastro es la parcela (IDERA, 2015)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12>
    a idera:ClaseCatalogo ;
    idera:codigo "12" ;
    rdfs:label "Unidades Geoestadísticas"@es ;
    skos:definition "Comprende los objetos geográficos que definen áreas estadísticas de desagregación del territotio nacional, provincial y de áreas de gobierno local. Se utilizan tanto para el relevamiento como para la publicación de resultados, y son comparables intercensalmente a pesar de la dinámica de distribución de la población (INDEC, 2018)."@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/23>
    a idera:ClaseCatalogo ;
    idera:codigo "23" ;
    rdfs:label "Abstracto"@es ;
    skos:definition "Este subgrupo consta de conceptos que se utilizan para modelar información sobre tipos de fenómenos, pero que en sí mismos no representan fenómenos. (Adaptación del DFDD) - IDESoB 2024"@es ;
    idera:esClaseDe idera:catalogo-v2-2 .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0101>
    a idera:SubclaseCatalogo ;
    idera:codigo "0101" ;
    rdfs:label "Extracción"@es ;
    skos:definition "Objetos geográficos que se relacionan con la extracción de materia prima, incluyendo agua e hidrocarburos (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0102>
    a idera:SubclaseCatalogo ;
    idera:codigo "0102" ;
    rdfs:label "Fabricación Y Procesamiento"@es ;
    skos:definition "Objetos geográficos que se relacionan con el procesamiento de materia prima y la obtención de bienes, incluyendo el tratamiento del agua (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0103>
    a idera:SubclaseCatalogo ;
    idera:codigo "0103" ;
    rdfs:label "Actividad Agropecuaria"@es ;
    skos:definition "Objetos geográficos asociados a actividades productivas y económicas del sector agrícola y ganadero y sus derivados. (UNTREF 2023 - MAGyP 2025)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0104>
    a idera:SubclaseCatalogo ;
    idera:codigo "0104" ;
    rdfs:label "Energía"@es ;
    skos:definition "Objetos geográficos que se relacionan con la producción, transporte y distribución de energía eléctrica (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0105>
    a idera:SubclaseCatalogo ;
    idera:codigo "0105" ;
    rdfs:label "Comunicaciones"@es ;
    skos:definition "Objetos geográficos que se refieren a todo tipo de infraestructura y servicios asociados a las comunicaciones tales como estructuras, redes y conexiones. (UNTREF 2023)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0106>
    a idera:SubclaseCatalogo ;
    idera:codigo "0106" ;
    rdfs:label "Estructura Asociada"@es ;
    skos:definition "Objetos geográficos que se relacionan con estructuras de apoyo asociadas a la Clase Industria y servicios (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0107>
    a idera:SubclaseCatalogo ;
    idera:codigo "0107" ;
    rdfs:label "Almacenamiento Y Logística"@es ;
    skos:definition "Objetos geográficos que se relacionan con el almacenamiento, protección, distribución y provisión de cualquier tipo de bien (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0108>
    a idera:SubclaseCatalogo ;
    idera:codigo "0108" ;
    rdfs:label "Gestión De Residuos"@es ;
    skos:definition "Objetos geográficos asociados a la recolección, tratamiento, reciclado y disposición de residuos (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0109>
    a idera:SubclaseCatalogo ;
    idera:codigo "0109" ;
    rdfs:label "Actividad Cinegética"@es ;
    skos:definition "Objetos geográficos relacionados a la práctica de la caza de animales en estado salvaje o silvestre, con o sin fines de lucro.(IDELP  2022 - UNTREF 2023)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/01> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0201>
    a idera:SubclaseCatalogo ;
    idera:codigo "0201" ;
    rdfs:label "Asentamiento"@es ;
    skos:definition "Objetos geográficos que se relacionan con centros poblados, sitios y lugares que revisten un interés particular (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0202>
    a idera:SubclaseCatalogo ;
    idera:codigo "0202" ;
    rdfs:label "Equipamiento"@es ;
    skos:definition "Objetos geográficos que están en relación con la prestación de servicios a la comunidad (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0203>
    a idera:SubclaseCatalogo ;
    idera:codigo "0203" ;
    rdfs:label "Comercio Y Turismo"@es ;
    skos:definition "Objetos geográficos que se refieren a actividades comerciales, a complejos con fines comerciales, turísticos y/o de negocios. En el caso del turismo, las actividades se realizan por un período determinado de tiempo, en un lugar distinto al del entorno habitual, y donde se desarrolla una actividad no remunerada (IDERA 2015 - INFUETUR 2024)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0204>
    a idera:SubclaseCatalogo ;
    idera:codigo "0204" ;
    rdfs:label "Recreación"@es ;
    skos:definition "Objetos geográficos que se relacionan con las actividades recreativas y de ocio de las personas (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0205>
    a idera:SubclaseCatalogo ;
    idera:codigo "0205" ;
    rdfs:label "Política Y Administración"@es ;
    skos:definition "Objetos geográficos que se relacionan con la política y / o que describen cuestiones administrativas (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0206>
    a idera:SubclaseCatalogo ;
    idera:codigo "0206" ;
    rdfs:label "Educación"@es ;
    skos:definition "Objetos geográficos relativos a los establecimientos vinculados al desarrollo de actividades educativas (IDERA, 2015)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0207>
    a idera:SubclaseCatalogo ;
    idera:codigo "0207" ;
    rdfs:label "Cultura"@es ;
    skos:definition "Objetos geográficos que se relacionan con las distintas expresiones culturales, credos y manifestaciones religiosas (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0208>
    a idera:SubclaseCatalogo ;
    idera:codigo "0208" ;
    rdfs:label "Salud"@es ;
    skos:definition "Objetos geográficos que se relacionan con instalaciones destinadas a brindar atención sanitaria (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0209>
    a idera:SubclaseCatalogo ;
    idera:codigo "0209" ;
    rdfs:label "Tecnología Y Ciencia"@es ;
    skos:definition "Objetos geográficos relativos a los establecimientos vinculados al desarrollo de actividades tecnológicas y científicas (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0210>
    a idera:SubclaseCatalogo ;
    idera:codigo "0210" ;
    rdfs:label "Derechos Humanos"@es ;
    skos:definition "Objetos geográficos relativos a la promoción y protección de los Derechos Humanos  (Secretaria de DDHH Bs As - 2019)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/02> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0301>
    a idera:SubclaseCatalogo ;
    idera:codigo "0301" ;
    rdfs:label "Ferroviario"@es ;
    skos:definition "Objetos geográficos que se refieren al transporte sobre rieles  (Transporte, 2018)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0302>
    a idera:SubclaseCatalogo ;
    idera:codigo "0302" ;
    rdfs:label "Vial"@es ;
    skos:definition "Objetos geográficos que se relacionan a las vías de comunicación para vehículos y personas. Se han incluido los fenómenos vías, carretera, carretera, camino, calles y carril bicicleta entre otros.  (Transporte, 2018)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0303>
    a idera:SubclaseCatalogo ;
    idera:codigo "0303" ;
    rdfs:label "Transporte Por Guía"@es ;
    skos:definition "Objetos geográficos relacionados a un transporte guiado por cable  (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0304>
    a idera:SubclaseCatalogo ;
    idera:codigo "0304" ;
    rdfs:label "Fluvial, Marítimo Y Lacustre"@es ;
    skos:definition "Objetos geográficos relacionados con el transporte a través de lagos, ríos, mares, océanos, canales o en otros cuerpos de agua continentales. (UNTREF 2023)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0305>
    a idera:SubclaseCatalogo ;
    idera:codigo "0305" ;
    rdfs:label "Aéreo"@es ;
    skos:definition "Objetos geográficos que se relacionan con el transporte por aire y la infraestructura relacionada (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0306>
    a idera:SubclaseCatalogo ;
    idera:codigo "0306" ;
    rdfs:label "Controles"@es ;
    skos:definition "Objetos geográficos que se relacionan al control del transporte (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0307>
    a idera:SubclaseCatalogo ;
    idera:codigo "0307" ;
    rdfs:label "Cruces Y Enlaces"@es ;
    skos:definition "Objetos geográficos vinculados a obras de ingeniería relacionadas al transporte, cuya función es facilitar la circulación (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0308>
    a idera:SubclaseCatalogo ;
    idera:codigo "0308" ;
    rdfs:label "Infraestructura De Transporte"@es ;
    skos:definition "Obras de la ingeniería que permitan el desarrollo del sistema de tránsito y transporte. (UNTREF 2023)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/03> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0401>
    a idera:SubclaseCatalogo ;
    idera:codigo "0401" ;
    rdfs:label "Costas Y Zonas Litorales"@es ;
    skos:definition "Objetos geográficos correspondientes a las costas y zonas del litoral marítimo, fluvial y lacustre (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0403>
    a idera:SubclaseCatalogo ;
    idera:codigo "0403" ;
    rdfs:label "Profundidades"@es ;
    skos:definition "Objetos geográficos que representan la profundidad en espejos de agua, corrientes de agua, mares y océanos (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0406>
    a idera:SubclaseCatalogo ;
    idera:codigo "0406" ;
    rdfs:label "Mareas Y Corrientes"@es ;
    skos:definition "Objetos geográficos relacionados con la medición de mareas, corrientes de agua y canales (IGN, 2015). Incluye instalaciones de monitoreo (INIDEP 2022)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0411>
    a idera:SubclaseCatalogo ;
    idera:codigo "0411" ;
    rdfs:label "Aguas Continentales"@es ;
    skos:definition "Objetos geográficos que se relacionan con el agua que fluye o se almacena sobre la corteza terrestre. Incluye objetos geográficos naturales y obras para su gestión y manejo (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0412>
    a idera:SubclaseCatalogo ;
    idera:codigo "0412" ;
    rdfs:label "Condiciones Oceanográficas"@es ;
    skos:definition "Este Subgrupo consta de Conceptos que describen las condiciones físicas y químicas del agua, por ejemplo temperatura o densidad. (Adaptacion del DFDD)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/04> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0501>
    a idera:SubclaseCatalogo ;
    idera:codigo "0501" ;
    rdfs:label "Hipsografía"@es ;
    skos:definition "Objetos geográficos que describen la forma (posiciones y alturas) de la superficie del terreno (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0502>
    a idera:SubclaseCatalogo ;
    idera:codigo "0502" ;
    rdfs:label "Geomorfología"@es ;
    skos:definition "Objetos geográficos que se refieren a las geoformas del relieve terrestre y sus características a excepción de las de origen glaciario (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0504>
    a idera:SubclaseCatalogo ;
    idera:codigo "0504" ;
    rdfs:label "Edafología"@es ;
    skos:definition "Objetos geográficos que hacen referencia a diferentes tipos de suelos y sus características (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0506>
    a idera:SubclaseCatalogo ;
    idera:codigo "0506" ;
    rdfs:label "Vulcanismo Y Sismicidad"@es ;
    skos:definition "Objetos geográficos  relacionados a la actividad sísmica y a la actividad volcánica (IDERA, 2015). Se entiende por vulcanismo al fenómeno de erupción de magma donde la lava, piroclastos y gases volcánicos son eruptados a través de un conducto de la superficie de la Tierra. (SEGEMAR, 2019)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0507>
    a idera:SubclaseCatalogo ;
    idera:codigo "0507" ;
    rdfs:label "Glaciología"@es ;
    skos:definition "Objetos geográficos que se relacionan con reservas hídricas estratégicas en estado sólido, nieve, hielo y otras geoformas de origen glaciario (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0510>
    a idera:SubclaseCatalogo ;
    idera:codigo "0510" ;
    rdfs:label "Geología"@es ;
    skos:definition "Objetos geográficos que hacen referencia a diferentes tipos de roca, según sus propiedades y edad; sus relaciones de contacto y estructuras geológicas (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0511>
    a idera:SubclaseCatalogo ;
    idera:codigo "0511" ;
    rdfs:label "Ecorregiones"@es ;
    skos:definition "Objetos geográficos que hacen referencia a territorios geográficamente definidos en los que dominan determinadas condiciones geomorfológicas y climáticas relativamente uniformes o recurrentes, caracterizados por una fisonomía vegetal de comunidades naturales y seminaturales que comparten un grupo considerable de especies dominantes, una dinámica y condiciones ecológicas generales cuyas interacciones son indispensables para su persistencia a largo plazo (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0512>
    a idera:SubclaseCatalogo ;
    idera:codigo "0512" ;
    rdfs:label "Degradación De Tierras Y Desertificación"@es ;
    skos:definition "Objetos geográficos que se refieren a la degradación de las tierras secas, fenómeno originado por las actividades humanas y las variaciones en el clima (CNULD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0513>
    a idera:SubclaseCatalogo ;
    idera:codigo "0513" ;
    rdfs:label "Áreas De Conservación Y Manejo Sustentable"@es ;
    skos:definition "Son zonas de ecosistemas continentales (terrestres o acuáticos), costeros/marinos o marinos, o una combinación de los mismos, con límites definidos y bajo un marco normativo acorde con sus objetivos de conservación, que constituyen una estrategia fundamental para la conservación a largo plazo de la diversidad biológica y cultural, proporcionando bienes y servicios ecosistémicos esenciales para la sociedad y la vida en general. (MAyDS 2023)"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/05> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0601>
    a idera:SubclaseCatalogo ;
    idera:codigo "0601" ;
    rdfs:label "Áreas De Cultivo"@es ;
    skos:definition "Objetos geográficos relacionados a áreas terrestres cultivadas y / o manejadas (LCCS FAO, INTA)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0602>
    a idera:SubclaseCatalogo ;
    idera:codigo "0602" ;
    rdfs:label "Áreas De Vegetación Natural Herbácea"@es ;
    skos:definition "Objetos geográficos referidos a áreas naturales y seminaturales con vegetación herbácea. Estas áreas pueden ser de vegetación predominantemente terrestre o predominantemente acuáticas (LCCS FAO, INTA)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0603>
    a idera:SubclaseCatalogo ;
    idera:codigo "0603" ;
    rdfs:label "Áreas De Vegetación Natural Arbórea"@es ;
    skos:definition "Objetos geográficos referidos a áreas naturales y seminaturales con vegetación arbórea. Estas áreas pueden ser de vegetación predominantemente terrestre o predominantemente acuáticas (LCCS FAO, INTA)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0609>
    a idera:SubclaseCatalogo ;
    idera:codigo "0609" ;
    rdfs:label "Áreas De Vegetación Natural Arbustiva"@es ;
    skos:definition "Objetos geográficos referidos a áreas naturales y seminaturales con vegetación arbustiva. Estas áreas pueden ser de vegetación predominantemente terrestre o predominantemente acuáticas (LCCS FAO, INTA)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/06> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0701>
    a idera:SubclaseCatalogo ;
    idera:codigo "0701" ;
    rdfs:label "Fronteras Y Límites"@es ;
    skos:definition "Objetos geográficos que se relacionan con la demarcación de diferentes tipos de límites entre jurisdicciones (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0703>
    a idera:SubclaseCatalogo ;
    idera:codigo "0703" ;
    rdfs:label "Redes Geodésicas"@es ;
    skos:definition "Objetos geográficos que materializan puntos sobre la superficie terrestre que poseen coordenadas geográficas (latitud, longitud) y altura sobre el nivel medio del mar, o valores de gravedad. Los puntos materializados se denominan pilares o mojones. Un grupo de pilares conforma una red geodésica (IGN, 2018)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0704>
    a idera:SubclaseCatalogo ;
    idera:codigo "0704" ;
    rdfs:label "Puntos Y Líneas Terrestres"@es ;
    skos:definition "Objetos geográficos correspondientes a las líneas y puntos referenciales y principales del sistema de coordenadas terrestres (IGN, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0705>
    a idera:SubclaseCatalogo ;
    idera:codigo "0705" ;
    rdfs:label "Planeamiento Urbano"@es ;
    skos:definition "Objetos territoriales legales definidos por un Código de Planeamiento Urbano que alcanzan y rigen aquellos asuntos relacionados directa o indirectamente con el uso del suelo, de edificios, estructuras e instalaciones, apertura y ensanche de vías públicas, subdivisión y englobamiento de parcelas, volúmenes edificables, tejido urbano, preservación de ámbitos históricos, arquitectónicos, ambientales y paisajísticos y con aquellos aspectos que tengan relación con el ordenamiento urbanístico del territorio de la Ciudad (AGC Catamarca, 2016)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/07> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/0901>
    a idera:SubclaseCatalogo ;
    idera:codigo "0901" ;
    rdfs:label "Infraestructura De Defensa"@es ;
    skos:definition "Objetos geográficos que se refieren a las instalaciones militares y a las estructuras operativas (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/09> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1001>
    a idera:SubclaseCatalogo ;
    idera:codigo "1001" ;
    rdfs:label "Fenómenos Meteorológicos"@es ;
    skos:definition "Objetos geográficos que describen fenómenos meteorológicos relativamente estables como las condiciones del viento (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1002>
    a idera:SubclaseCatalogo ;
    idera:codigo "1002" ;
    rdfs:label "Condiciones Del Clima"@es ;
    skos:definition "Objetos geográficos que describen las condiciones climáticas como la temperatura o la precipitación (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1003>
    a idera:SubclaseCatalogo ;
    idera:codigo "1003" ;
    rdfs:label "Zonas Y Regiones Climáticas"@es ;
    skos:definition "Objetos geográficos que describen zonas y / o regiones de clima con las condiciones climáticas especiales (adaptación DFDD)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/10> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1101>
    a idera:SubclaseCatalogo ;
    idera:codigo "1101" ;
    rdfs:label "Parcelario"@es ;
    skos:definition "Objetos territoriales legales relacionados con datos concernientes a los objetos territoriales legales de un determinado país o distrito, basado en la mensura de sus límites, metódicamente ordenados (IDERA, 2015)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1102>
    a idera:SubclaseCatalogo ;
    idera:codigo "1102" ;
    rdfs:label "Minero"@es ;
    skos:definition "Objetos territoriales legales relacionados al registro público de los Derechos Mineros existentes. Éste mantiene el registro y documentos inherentes de la identificación, ubicación, extensión, tipo y propiedad de las áreas afectadas de solicitudes y derechos mineros. Se encuentra organizado para cumplir funciones fiscales, jurídicas y administrativas (AGC Catamarca, 2016)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/11> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1201>
    a idera:SubclaseCatalogo ;
    idera:codigo "1201" ;
    rdfs:label "Divisiones Censales"@es ;
    skos:definition "Comprende el conjunto de divisiones del territorio diseñadas por el INDEC que permiten aseguran la cobertura total del país al momento de llevar adelante los distintos operativos censales (INDEC, 2018)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/1202>
    a idera:SubclaseCatalogo ;
    idera:codigo "1202" ;
    rdfs:label "Áreas Urbanas Censales"@es ;
    skos:definition "Comprende aquellas porciones del territorio donde se asienta la población y que presenta características distintivas y particulares que permiten diferenciarlas de aquellas zonas no urbanas (INDEC, 2018)."@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/12> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/subclase/2301>
    a idera:SubclaseCatalogo ;
    idera:codigo "2301" ;
    rdfs:label "Entidad De Información"@es ;
    skos:definition "Entidades que se utilizan para modelar la información relativa a los tipos de fenómenos, pero que no representan fenómenos en sí mismos. Por ejemplo, las características del pavimento compartidas por muchos tipos de rutas de transporte terrestre, o las características de calidad de los datos compartidas por todas las masas de agua continentales. (Adaptación del DFDD) - IDESoB 2024"@es ;
    idera:esSubclaseDe <https://cdg-idera.github.io/ontologias/catalogo-objetos/clase/23> .

