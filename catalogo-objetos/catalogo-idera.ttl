<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDV>
    a idera:AtributoCatalogado ;
    idera:codigo "CDV" ;
    rdfs:label "Fecha y hora del evento"@es ;
    skos:definition "Combinación de fecha y hora acorde al formato establecido en la Norma ISO 8601:2000 5.4.1, donde [AAAA] representa un año calendario, [MM] el número ordinal de un mes natural, en el año calendario, [DD] el número ordinal de un día dentro del mes calendario, [ hh] el número ordinal de una hora dentro del día natural, [mm] el número ordinal de un minuto antes de una hora, [ss] el número ordinal de un segundo en el minuto, y una 'Z' opcional cuando el tiempo es de acuerdo al Tiempo universal Coordinado (UTC)."@es ;
    idera:tipoAtributo "Cadena de caracteres"@es ;
    idera:tieneDominio "NO" ;
    idera:observacionFuente "YYYY-MM-DDThh:mm:ssZ"@es ;
    idera:definePropiedadImplementable <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/CDV> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/property/CDV>
    a owl:DatatypeProperty ;
    rdfs:label "Fecha y hora del evento"@es ;
    idera:implementaAtributo <https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDV> .

