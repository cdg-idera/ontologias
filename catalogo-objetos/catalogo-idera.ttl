    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "021001" ;
    rdfs:label "Ex centro clandestino de detencion"@es ;
    skos:definition "Lugares que funcionaron como centros clandestinos de detención, durante el terrorismo de Estado ejercido en el país hasta el 10 de diciembre de 1983. (Leyes Nacional 26691 y Provincial 13584). Se incluye toda dependencia, lugar o predio militar, policial, privado o de propiedad estatal, que durante el período mencionado, hubiera alojado detenidos en forma ilegal o clandestina. (Sec DDHH Bs As - 2019)"@es ;
    idera:tipoGeometrico "Punto"@es ;
    idera:dbyf "NO" ;
