<https://cdg-idera.github.io/ontologias/catalogo-objetos/og/110107>
    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "110107" ;
    rdfs:label "Conjunto Inmobiliario"@es ;
    skos:definition "Son conjuntos inmobiliarios los clubes de campo, barrios cerrados o privados, parques industriales, empresariales o náuticos, o cualquier otro emprendimiento urbanístico independientemente del destino de vivienda permanente o temporaria, laboral, comercial o empresarial que tenga, comprendidos asimismo aquellos que contemplan usos mixtos, con arreglo a lo dispuesto en las normas administrativas locales. (ARBA 2019)"@es ;
    idera:tipoGeometrico "Polígono"@es ;
    idera:dbyf "NO" ;
