    rdfs:label "Yacimiento mineral"@es ;
    idera:implementaObjetoGeografico <https://cdg-idera.github.io/ontologias/catalogo-objetos/og/010102> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/og/010103>
    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "010103" ;
    rdfs:label "Área de explotación hidrocarburífera"@es ;
    skos:definition "Área donde se efectúa una actividad extractiva de origen hidrocarburífera para su aprovechamiento económico."@es ;
    idera:tipoGeometrico "Polígono"@es ;
    idera:dbyf "SI" ;
