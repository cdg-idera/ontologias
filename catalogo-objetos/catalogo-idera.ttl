    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "110105" ;
    rdfs:label "Subparcela"@es ;
    skos:definition "La propiedad de la unidad funcional o subparcela comprende la parte indivisa del terreno, de las cosas y partes de uso común del inmueble o indispensables para mantener su seguridad, y puede abarcar una o más unidades complementarias destinadas a servirla (ARBA, 2018)."@es ;
