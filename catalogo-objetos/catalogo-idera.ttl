<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CDE>
    a idera:AtributoCatalogado ;
    idera:codigo "CDE" ;
    rdfs:label "Código Departamento"@es ;
    skos:definition "El código numérico de División Político-Administrativa se conforma, leído de izquierda a derecha, con DOS (2) dígitos que identifican a la Provincia o Ciudad de Buenos Aires (División Político-Territorial), y TRES (3) dígitos que identifican a la División Político-Administrativa (Comunas en la Ciudad de Buenos Aires, Partidos en la Provincia de BUENOS AIRES y Departamentos en las demás Provincias)."@es ;
    idera:tipoAtributo "Cadena de caracteres"@es ;
    idera:tieneDominio "NO" ;
    idera:observacionFuente "5 caracteres"@es ;
    idera:definePropiedadImplementable <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/CDE> .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/property/CDE>
