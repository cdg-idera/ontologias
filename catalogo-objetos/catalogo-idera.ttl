    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "010102" ;
    rdfs:label "Yacimiento mineral"@es ;
    skos:definition "Parte de la corteza terrestre en la cual, debido a procesos geológicos, ha habido acumulación de  materias primas minerales susceptibles de ser explotadas para el aprovechamiento de sus propiedades físicas o químicas."@es ;
    idera:tipoGeometrico "Polígono"@es ;
