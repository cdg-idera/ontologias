    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "120202" ;
    rdfs:label "Aglomerado"@es ;
    skos:definition "Unidad territorial resultante de la agregación de dos o más localidades censales, que se extiende en dos o\nmás áreas político-administrativas, ya sean de primer o segundo nivel, o gobiernos locales. Si supera los 100.000 habitantes, Se antepone al nombre del aglomerado el término “Gran”.  (INDEC 2025)"@es ;
    idera:tipoGeometrico "Linea / Polìgono"@es ;
    idera:dbyf "NO" ;
