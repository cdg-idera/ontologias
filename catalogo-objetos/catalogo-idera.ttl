    a idera:AtributoCatalogado ;
    idera:codigo "IPS" ;
    rdfs:label "Índice de Productividad de los Suelos"@es ;
    skos:definition "Clasificación de los suelos según el nivel de productividad de las tierras, desagregados a nivel de unidad cartográfica.  Emplea una fórmula multiplicativa de los factores climáticos, de suelo y terreno que inciden en el crecimiento y rendimiento de los cultivos, pasturas y forestales más comunes de una región, bajo un determinado nivel de manejo.  Se clasifica de 100 a 1."@es ;
    idera:tipoAtributo "Numérico"@es ;
    idera:tieneDominio "NO" ;
    idera:definePropiedadImplementable <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/IPS> .

