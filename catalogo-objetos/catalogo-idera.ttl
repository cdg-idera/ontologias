    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "041115" ;
    rdfs:label "Subcuenca hidrográfica"@es ;
    skos:definition "Superficie de terreno cuya escorrentía superficial fluye en su totalidad a través de una serie de corrientes, ríos y, eventualmente, lagos, hacia un determinado punto de un curso de agua, generalmente un lago o una confluencia de ríos. (IDESoB 2024)"@es ;
    idera:tipoGeometrico "Polígono"@es ;
    idera:dbyf "NO" ;
