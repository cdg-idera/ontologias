<https://cdg-idera.github.io/ontologias/catalogo-objetos/og/041112>
    a idera:ObjetoGeograficoCatalogado ;
    idera:codigo "041112" ;
    rdfs:label "Tajamar"@es ;
    skos:definition "Obra que une dos laderas que se aproximan mediante una cortina de tierra bien apisonada, con el objetivo de detener el escurrimiento del agua de lluvia, formando un espejo de agua."@es ;
    idera:tipoGeometrico "Línea"@es ;
    idera:dbyf "NO" ;
