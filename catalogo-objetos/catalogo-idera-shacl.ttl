<https://cdg-idera.github.io/ontologias/catalogo-objetos/shacl/conformidad>
    a owl:Ontology ;
    dcterms:title "SHACL de conformidad del Catálogo de Objetos Geográficos de IDERA"@es ;
    dcterms:description "Shapes SHACL generados exclusivamente a partir de características explícitas del Catálogo IDERA V2.2. Los atributos no se consideran obligatorios por el solo hecho de estar asociados a un Objeto Geográfico."@es ;
    dcterms:source "Catálogo de Objetos Geográficos de IDERA V2.2"@es ;
    dcterms:language "es" ;
    owl:versionInfo "2.2" .

<https://cdg-idera.github.io/ontologias/catalogo-objetos/shape/og/010101>
    a sh:NodeShape ;
    sh:targetClass <https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010101> ;
    rdfs:label "Conformidad Yacimiento hidrocarburífero"@es ;
    sh:property [
        sh:path <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/CAA> ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "El atributo CAA (Autoridad responsable), cuando está presente, debe utilizar un datatype compatible con el tipo IDERA Cadena de caracteres."@es
    ] ;
    sh:property [
        sh:path <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/FNA> ;
