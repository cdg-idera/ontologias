    sh:targetClass <https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/100303> ;
    rdfs:label "Conformidad Zona según frecuencia anual media de nevadas"@es ;
    sh:property [
        sh:path <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/IFN> ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "El atributo IFN (Frecuencia de nevadas), cuando está presente, debe utilizar un datatype compatible con el tipo IDERA Cadena de caracteres."@es
    ] ;
    sh:property [
        sh:path <https://cdg-idera.github.io/ontologias/catalogo-objetos/property/SAG> ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "El atributo SAG (Autoridad de fuente), cuando está presente, debe utilizar un datatype compatible con el tipo IDERA Cadena de caracteres."@es
    ] ;
    dcterms:source "Catálogo de Objetos Geográficos de IDERA V2.2"@es .

