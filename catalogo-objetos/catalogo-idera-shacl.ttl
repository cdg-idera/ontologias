# -----------------------------------------------------------------------------
# Validación de propiedades locales mapeadas mediante idera:correspondeAtributo
# -----------------------------------------------------------------------------

<https://cdg-idera.github.io/ontologias/catalogo-objetos/shape/mapeo/010101>
    a sh:NodeShape ;
    sh:targetClass <https://cdg-idera.github.io/ontologias/catalogo-objetos/feature/010101> ;
    rdfs:label "Validación de atributos mapeados para 010101"@es ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Una propiedad local mapeada a un atributo IDERA debe utilizar un datatype compatible con el tipo declarado para ese atributo."@es ;
        sh:select """PREFIX idera: <https://cdg-idera.github.io/ontologias/catalogo-objetos/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this ?propiedadLocal ?value
WHERE {
  $this ?propiedadLocal ?value .
  ?propiedadLocal idera:correspondeAtributo ?atributoIDERA .

  VALUES (?atributoIDERA ?tipoEsperado) {
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/CAA> <http://www.w3.org/2001/XMLSchema#string>)
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FNA> <http://www.w3.org/2001/XMLSchema#string>)
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/FUN> <http://www.w3.org/2001/XMLSchema#string>)
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/GNA> <http://www.w3.org/2001/XMLSchema#string>)
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/NAM> <http://www.w3.org/2001/XMLSchema#string>)
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/PPO> <http://www.w3.org/2001/XMLSchema#string>)
      (<https://cdg-idera.github.io/ontologias/catalogo-objetos/atributo/SAG> <http://www.w3.org/2001/XMLSchema#string>)
  }

  FILTER (
    (?tipoEsperado = "NUMERIC" &&
      datatype(?value) NOT IN (
        xsd:decimal, xsd:integer, xsd:double, xsd:float,
        xsd:long, xsd:int, xsd:short, xsd:byte,
        xsd:nonNegativeInteger, xsd:positiveInteger,
        xsd:nonPositiveInteger, xsd:negativeInteger,
        xsd:unsignedLong, xsd:unsignedInt, xsd:unsignedShort, xsd:unsignedByte
      )
    )
    ||
    (?tipoEsperado != "NUMERIC" && datatype(?value) != ?tipoEsperado)
  )
}"""
    ] .


<https://cdg-idera.github.io/ontologias/catalogo-objetos/shape/mapeo/010102>
    a sh:NodeShape ;
